---
import type { ReleaseCategory } from '../../lib/music-releases';
interface Props { category: ReleaseCategory }
const { category } = Astro.props;
---

<section class="release-row" aria-labelledby={`category-${category.id}`}>
  <div class="category-info">
    <h2 id={`category-${category.id}`}>{category.name}</h2>
    <p>{category.releases.length} releases</p>
  </div>
  <ul aria-label={`${category.name} releases`}>
    {category.releases.map(release => (
      <li>
        <a href={`/music-releases/${release.slug}`}>
          <img src={release.artwork} alt="" width="320" height="320" loading="lazy" />
          <span>{release.title}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .release-row {
    --cover-size: clamp(8rem, 16vw, 12rem);
    display: grid;
    grid-template-columns: clamp(7rem, 18vw, 12rem) minmax(0, 1fr);
    gap: .75rem;
    padding: .75rem;
    border: 1px solid var(--nord3);
    color: var(--color-foreground);
  }
  .category-info { display: flex; flex-direction: column; justify-content: center; text-align: center; overflow-wrap: anywhere; }
  h2 { font-size: clamp(1rem, 1.6vw, 1.25rem); font-weight: 400; line-height: 1.3; margin: 0 0 .5rem; }
  p { color: var(--nord4); font-size: .8rem; }
  ul { display: flex; gap: .75rem; overflow-x: auto; min-width: 0; list-style: none; padding: .25rem; margin: 0; }
  li { flex: 0 0 var(--cover-size); }
  a { display: block; color: inherit; text-decoration: none; font-size: .85rem; line-height: 1.5; }
  a:hover span { text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--nord8); outline-offset: 2px; }
  img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; background: var(--nord1); margin-bottom: .5rem; }
  @media (max-width: 30rem) {
    .release-row { grid-template-columns: minmax(0, 1fr); }
    .category-info { text-align: left; }
  }
</style>
