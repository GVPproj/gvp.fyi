---
import Sig from './Sig.astro'
import Github from './Github.astro'
import ChevronDown from './ChevronDown.astro'
import PixelMenu from './PixelMenu.astro'

const path = Astro.url.pathname

import { siteSettings } from '../lib/editorial-content'
const matches = (href?: string) => !!href && (path === href || path.startsWith(`${href}/`))
type NavigationItem = { id?: string; label: string; href?: string; children?: { label: string; href: string }[] }
const navigation = siteSettings.navigation.map((item: NavigationItem, index) => {
  const children = item.children?.map(child => ({ ...child, current: matches(child.href) }))
  const id = item.id ?? `nav-${index}`
  if (!/^[a-z][a-z0-9-]*$/.test(id)) throw new Error('Navigation IDs must be stable lowercase identifiers')
  return { ...item, id, children, current: children ? children.some(child => child.current) : matches(item.href) }
})
if (new Set(navigation.map(item => item.id)).size !== navigation.length) throw new Error('Navigation IDs must be unique')
---

<header class="site-header">
  <a
    href="/"
    aria-label="Go back to the homepage"
    aria-current={path === '/' ? 'page' : undefined}
    class:list={['home', { current: path === '/' }]}
  >
    <Sig />
  </a>

  <nav class="desktop" aria-label="Main navigation">
    <ul>
      {navigation.map((group) => group.children ? (
        <li class="nav-group" style={`anchor-name: --${group.id}`}>
          <button type="button" class:list={['group-toggle', { current: group.current }]} popovertarget={`${group.id}-menu`}>
            {group.label}<ChevronDown />
          </button>
          <div id={`${group.id}-menu`} class="dropdown" popover style={`position-anchor: --${group.id}`}>
            <ul>
              {group.children.map((child) => (
                <li><a href={child.href} class:list={{ current: child.current }} aria-current={child.current ? 'page' : undefined}>{child.label}</a></li>
              ))}
            </ul>
          </div>
        </li>
      ) : (
        <li><a href={group.href} class:list={{ current: group.current }} aria-current={group.current ? 'page' : undefined}>{group.label}</a></li>
      ))}
      <li>
        <a href="https://github.com/GVPproj" target="_blank" rel="noopener noreferrer" aria-label="Visit my GitHub profile">
          <Github width="22" height="22" />
        </a>
      </li>
    </ul>
  </nav>

  <!-- Native popover: light-dismiss, Escape, top layer and the ARIA wiring
       come free, and the menu works before JS loads — which the Radix
       dropdown it replaces did not. Accepted tradeoff: no focus trap, which
       is fine for this navigation drawer. -->
  <button
    type="button"
    popovertarget="site-nav"
    class="menu-toggle"
    aria-label="Open menu"
  >
    <PixelMenu />
  </button>

  <!-- Native right-side drawer styled after unbusy.day's pixel menu. -->
  <nav popover id="site-nav" aria-label="Mobile navigation">
    <button type="button" popovertarget="site-nav" popovertargetaction="hide" class="menu-close" aria-label="Close menu"><PixelMenu open /></button>
    <ul>
      <li>
        <a href="/" class:list={{ current: path === '/' }} aria-current={path === '/' ? 'page' : undefined}>
          <span>{siteSettings.homeLabel}</span>
          <span class="chev" aria-hidden="true">›</span>
        </a>
      </li>
      {navigation.map((group) => group.children ? (
        <li>
          <details open={group.current}>
            <summary class:list={{ current: group.current }}>{group.label}<ChevronDown /></summary>
            <ul>
              {group.children.map((child) => (
                <li><a href={child.href} class:list={{ current: child.current }} aria-current={child.current ? 'page' : undefined}>{child.label}</a></li>
              ))}
            </ul>
          </details>
        </li>
      ) : (
        <li><a href={group.href} class:list={{ current: group.current }} aria-current={group.current ? 'page' : undefined}><span>{group.label}</span>{group.href !== '/software' && <span class="chev" aria-hidden="true">›</span>}</a></li>
      ))}
      <li>
        <a href="https://github.com/GVPproj" target="_blank" rel="noopener noreferrer">
          <span class="gh"><Github width="22" height="22" /> GitHub</span>
          <span class="chev" aria-hidden="true">↗</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // View transitions snapshot the top layer separately from the page root, so
  // a menu left open during navigation would hang over the outgoing frame and
  // pop out of existence at the swap. Closing it here instead lets the exit
  // run on the slide-out transition the popover CSS already describes.
  document.addEventListener('astro:before-preparation', () => {
    document.querySelectorAll<HTMLElement>('.site-header [popover]').forEach((menu) => menu.hidePopover())
  })

  // Brightens the header's border once it's floating over content. The header
  // is re-rendered on every client-side navigation, so bind per page load.
  let cleanup = () => {}
  let controller = new AbortController()

  function bindScroll() {
    const header = document.querySelector<HTMLElement>('header.site-header')
    if (!header) return
    const update = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 24)
    }
    update()
    window.addEventListener('scroll', update, { passive: true })
    cleanup = () => window.removeEventListener('scroll', update)
  }

  function bindScrollLock() {
    const nav = document.querySelector<HTMLElement>('#site-nav')
    if (!nav) return
    const desktop = window.matchMedia('(min-width: 48rem)')
    desktop.addEventListener('change', () => {
      if (desktop.matches) nav.hidePopover()
      else document.querySelectorAll<HTMLElement>('.dropdown').forEach((menu) => menu.hidePopover())
    }, { signal: controller.signal })
    nav.addEventListener('beforetoggle', (e) => {
      document.documentElement.style.overflow =
        (e as ToggleEvent).newState === 'open' ? 'hidden' : ''
    })
  }

  function bind() {
    cleanup()
    controller.abort()
    controller = new AbortController()
    document.documentElement.style.overflow = ''
    bindScroll()
    bindScrollLock()
  }
  document.addEventListener('astro:page-load', bind)
</script>

<style>
  header {
    display: flex;
    width: 100%;
    justify-content: space-between;
    padding: 1.5rem;
  }

  /* Desktop: a sticky, frosted bar. It must be a direct child of <body>
     (the scroll container) for `position: sticky` to work — any wrapper
     would become its containing block and it would never stick. */
  @media (width >= 48rem) {
    header {
      position: sticky;
      top: 1rem;
      z-index: 10;
      width: fit-content;
      min-width: 0;
      align-items: center;
      gap: 1.75rem;
      margin-block: 1rem 2.5rem;
      padding: 1rem 2rem 1rem 1.625rem;
      border: 1px solid var(--ink-700);
      border-radius: 0;
      background-color: color-mix(in srgb, var(--colour-fill) 80%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 4px 12px -6px hsl(204 80% 6% / 0.3);
      transition: border-color 200ms ease;
    }

    header[data-scrolled] {
      border-color: var(--ink-500);
    }

    /* Sig sets its own size (and bumps it at 64rem); the bar needs it small
       at every desktop width. */
    header :global(.sig) {
      width: 9rem;
      height: 2.25rem;
    }
  }

  .home {
    display: flex;
    align-items: center;
    color: var(--colour-text-base);
  }

  .home:hover {
    color: var(--colour-highlight);
  }

  .home.current {
    color: var(--colour-accent);
  }

  nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  a {
    text-decoration: none;
  }

  a:focus-visible,
  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--colour-accent);
    outline-offset: 4px;
  }

  nav a {
    color: var(--colour-text-base);
  }

  nav a:hover,
  .group-toggle:hover,
  summary:hover {
    color: var(--colour-highlight);
  }

  nav a.current,
  .group-toggle.current,
  summary.current {
    color: var(--colour-accent);
  }

  .desktop {
    display: none;
    align-self: center;
  }

  .desktop li > a {
    display: flex;
    align-items: center;
    min-height: 1.75rem;
  }

  .desktop > ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 500;
  }

  @media (width >= 48rem) {
    /* hairline divider between sig and links */
    .desktop {
      display: block;
      padding-inline-start: 1.75rem;
      border-inline-start: 1px solid var(--ink-700);
    }

    .menu-toggle {
      display: none;
    }
  }

  .group-toggle,
  summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
  }

  .group-toggle {
    padding: 0;
    border: 0;
    background: none;
    color: var(--colour-text-base);
    font: inherit;
  }

  .group-toggle :global(svg),
  summary :global(svg) {
    flex-shrink: 0;
    transition: transform 180ms ease;
  }

  .nav-group:has(.dropdown:popover-open) .group-toggle :global(svg),
  details[open] > summary :global(svg) {
    transform: rotate(180deg);
  }

  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }

  #site-nav details ul {
    padding-inline-start: 1rem;
    font-size: 1.125rem;
  }

  .dropdown {
    /* Centered below the bar on browsers without CSS anchor positioning. */
    position: fixed;
    inset: 6rem 1rem auto;
    width: max-content;
    min-width: 10rem;
    margin: 0 auto;
    padding: 0.5rem;
    border: 1px solid var(--ink-500);
    border-radius: 0;
    background: var(--colour-fill);
    color: var(--colour-text-base);
    box-shadow: 0 4px 12px -6px hsl(204 80% 6% / 0.3);
    font: 500 1.125rem/1.5 var(--font-sans);
  }

  @supports (top: anchor(bottom)) {
    .dropdown {
      inset: auto;
      top: anchor(bottom);
      right: anchor(right);
      margin: 1.5rem 0 0;
      position-try-fallbacks: flip-inline;
    }
  }

  .dropdown a {
    display: block;
    padding: 0.625rem 0.875rem;
    border-radius: 0;
  }

  .dropdown a:hover { background: var(--colour-fill-muted); }

  .menu-toggle,
  .menu-close {
    position: fixed;
    top: 0.875rem;
    right: 1rem;
    z-index: 10;
    width: 44px;
    height: 44px;
    padding: 9px;
    border: 1px solid var(--ink-500);
    border-radius: 0;
    background: var(--colour-fill);
    color: var(--colour-text-base);
    box-shadow: 3px 3px 0 var(--ink-700);
    cursor: pointer;
  }

  .menu-close { position: absolute; }

  /* Pixel drawer: solid surface, hard edges, right-side entrance. */
  #site-nav {
    inset: 0 0 0 auto;
    width: min(260px, 100%);
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 4.75rem 0.75rem max(1.5rem, env(safe-area-inset-bottom));
    border: 0;
    border-inline-start: 1px solid var(--ink-500);
    border-radius: 0;
    background: var(--colour-fill);
    box-shadow: -4px 0 0 var(--ink-700);
    color: var(--colour-text-base);
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateX(100%);
    /* allow-discrete lets `display` and the top layer participate in the
       transition, so the drawer slides out instead of vanishing. */
    transition:
      opacity 0.2s ease-out,
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      overlay 0.25s ease-out allow-discrete,
      display 0.25s ease-out allow-discrete;
  }

  #site-nav:popover-open {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    #site-nav:popover-open {
      opacity: 0;
      transform: translateX(100%);
    }
  }

  #site-nav::backdrop {
    background: hsl(204 80% 6% / 0.55);
    transition: background 0.25s ease-out;
  }

  @starting-style {
    #site-nav:popover-open::backdrop {
      background: transparent;
    }
  }

  #site-nav ul {
    font-family: var(--font-sans);
    font-size: 1.375rem;
    line-height: 1.75rem;
    font-weight: 500;
  }

  #site-nav li + li { margin-block-start: 0.5rem; }

  #site-nav a:hover,
  #site-nav summary:hover,
  #site-nav a.current { background: var(--colour-fill-muted); }

  #site-nav a,
  #site-nav summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
  }

  /* :active gives instant press feedback, replacing the old 0.8s
     flash-return-sleep sequence that ran before every navigation. */
  #site-nav a:active {
    color: var(--colour-highlight);
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .chev {
    color: var(--ink-300);
    font-size: 1.5rem;
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    header,
    .group-toggle :global(svg),
    summary :global(svg),
    [popover],
    [popover]::backdrop {
      transition: none;
    }
  }
</style>
