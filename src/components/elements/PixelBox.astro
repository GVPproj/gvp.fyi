---
import type { HTMLTag, Polymorphic } from 'astro/types';

type Props = Polymorphic<{ as: HTMLTag }>;

const { as: Tag = 'div', class: className, ...attributes } = Astro.props;
---

<Tag class:list={['pixel-box', className]} {...attributes}>
  <slot />
</Tag>

<style>
  .pixel-box {
    box-sizing: border-box;
    min-width: 0;
    margin: 0;
    border: 2px solid #171c25;
    background: var(--nord1);
    box-shadow: inset 2px 2px 0 var(--nord3), inset -2px -2px 0 var(--nord0), 4px 6px 0 #1d222c;
  }
</style>
