---
import ItemsBoard from './ItemsBoard.astro';
import CollectionRows from './CollectionRows.astro';
import { collectionRows } from '../../lib/likes-presentation';
import { publishedLikes, publishedCollectionGroups as grouped, publishedCollectionOverview } from '../../lib/published-likes.js';
const rows = collectionRows(publishedCollectionOverview, item => item.publishedAsset?.url ?? null,
  id => `#${encodeURIComponent(`collection-${id}`)}`);
---
<div class="static-likes">
<nav aria-label="Collections">
  <a href="/likes">Collections</a>
  <a href="#all-items">All items</a>
  {grouped.map(group => <a href={`#${encodeURIComponent(`collection-${group.id}`)}`}>{group.name}</a>)}
</nav>
<div class="static-overview"><CollectionRows {rows} /></div>
{grouped.map(group => <section class="static-items" id={`collection-${group.id}`}>
  <h2>{group.name}</h2>
  <ItemsBoard items={group.items} assetURL={item => item.publishedAsset?.url ?? null}
    emptyMessage="No published items in this collection." />
</section>)}
<section class="static-items" id="all-items">
  <h2>All items</h2>
  <ItemsBoard items={publishedLikes} assetURL={item => item.publishedAsset?.url ?? null} />
</section>
</div>
<script>
  // Preserve incoming query-based collection links from the former live reader.
  // All content remains readable and navigable with JavaScript disabled.
  function selectIncomingCollection() {
    const query = new URLSearchParams(location.search);
    const collection = query.get('collection');
    const target = collection ? document.getElementById(`collection-${collection}`)
      : query.get('view') === 'all' || query.has('afterId') ? document.getElementById('all-items') : null;
    if (target && !location.hash) location.replace(`#${encodeURIComponent(target.id)}`);
  }
  document.addEventListener('astro:page-load', selectIncomingCollection);
  selectIncomingCollection();
</script>
<style>
  nav { display: flex; flex-wrap: wrap; gap: .75rem; margin-block: 1rem; }
  .static-items { margin-block: 2rem; scroll-margin-top: 5rem; }
  .static-items:not(:target) { display: none; }
  .static-likes:has(> .static-items:target) .static-overview { display: none; }
</style>
