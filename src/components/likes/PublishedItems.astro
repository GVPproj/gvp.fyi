---
import PublishedItem from './PublishedItem.astro';
import { createLikesAPI } from '../../lib/likes.js';

interface Props {
  items?: Array<Record<string, any>>;
  collections?: Array<{ id: string; name: string }>;
  selectedCollection?: string;
  nextCursor?: { created: string; id: string } | null;
  error?: string;
  endpoint?: string;
}

const { items = [], collections = [], selectedCollection = '', nextCursor = null, error = '', endpoint = '' } = Astro.props;
const api = createLikesAPI(endpoint);
const unknownCollection = !!selectedCollection && !collections.some(collection => collection.id === selectedCollection);
function boardURL(collection = '', cursor: Props['nextCursor'] = null) {
  const query = new URLSearchParams();
  if (collection) query.set('collection', collection);
  if (cursor) {
    query.set('afterCreated', cursor.created);
    query.set('afterId', cursor.id);
  }
  return `/likes${query.size ? `?${query}` : ''}`;
}
---

<nav id="collection-filters" aria-label="Named collections">
  <a href={boardURL()} aria-current={!selectedCollection ? 'page' : undefined}>All items</a>
  {collections.map(collection => (
    <a href={boardURL(collection.id)} aria-current={selectedCollection === collection.id ? 'page' : undefined}>{collection.name}</a>
  ))}
</nav>

{error ? (
  <p role="status">{error} <a href={boardURL(selectedCollection)}>Try again</a>.</p>
) : unknownCollection ? (
  <p role="status">This named collection could not be found. <a href={boardURL()}>View all items</a>.</p>
) : (
  <>
    {items.length ? (
      <ul id="likes-board" aria-label="Published likes">
        {items.map(item => <PublishedItem item={item} assetURL={api.assetURL(item)} />)}
      </ul>
    ) : (
      <p role="status">{selectedCollection ? 'No published items in this named collection.' : 'No published items to show.'}</p>
    )}
    {nextCursor && <nav aria-label="Likes pagination"><a href={boardURL(selectedCollection, nextCursor)}>Older items</a></nav>}
  </>
)}

<style>
  #collection-filters { display: flex; flex-wrap: wrap; gap: .75rem; margin-block: 1rem; }
  #collection-filters [aria-current="page"] { font-weight: bold; text-decoration: underline; }
  #likes-board { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: 2rem 1.5rem; align-items: start; }
</style>
