---
import ItemsBoard from './ItemsBoard.astro';
import CollectionRows from './CollectionRows.astro';
import { collectionRows, type CollectionOverview } from '../../lib/likes-presentation';
import { createLikesAPI, MISC_COLLECTION } from '../../lib/likes.js';

interface Props {
  items?: Array<Record<string, any>>;
  collections?: Array<{ id: string; name: string }>;
  selectedCollection?: string;
  nextCursor?: { created: string; id: string } | null;
  error?: string;
  endpoint?: string;
  overview?: CollectionOverview[] | null;
}

const { items = [], collections = [], selectedCollection = '', nextCursor = null, error = '', endpoint = '', overview = null } = Astro.props;
const api = createLikesAPI(endpoint);
const unknownCollection = !!selectedCollection && selectedCollection !== MISC_COLLECTION && !collections.some(collection => collection.id === selectedCollection);
const collectionName = selectedCollection === MISC_COLLECTION ? 'Misc.' : collections.find(collection => collection.id === selectedCollection)?.name;
function boardURL(collection = '', cursor: Props['nextCursor'] = null) {
  const query = new URLSearchParams();
  if (collection) query.set('collection', collection);
  else query.set('view', 'all');
  if (cursor) {
    query.set('afterCreated', cursor.created);
    query.set('afterId', cursor.id);
  }
  return `/likes${query.size ? `?${query}` : ''}`;
}
---

<nav id="collection-filters" aria-label="Collections">
  <a href="/likes" aria-current={overview !== null ? 'page' : undefined}>{overview !== null ? 'Collections' : '← Collections'}</a>
  <a href={boardURL()} aria-current={overview === null && !selectedCollection ? 'page' : undefined}>All items</a>
  {overview === null && <>
    {collections.map(collection => (
      <a href={boardURL(collection.id)} aria-current={selectedCollection === collection.id ? 'page' : undefined}>{collection.name}</a>
    ))}
    <a href={boardURL(MISC_COLLECTION)} aria-current={selectedCollection === MISC_COLLECTION ? 'page' : undefined}>Misc.</a>
  </>}
</nav>

{error ? (
  <p role="status">{error} <a href={overview !== null ? '/likes' : boardURL(selectedCollection)}>Try again</a>.</p>
) : unknownCollection ? (
  <p role="status">This named collection could not be found. <a href="/likes">View collections</a>.</p>
) : overview !== null ? (
  <CollectionRows rows={collectionRows(overview, item => api.assetURL(item), id => boardURL(id))} />
) : (
  <>
    <h2>{collectionName || 'All items'}</h2>
    <ItemsBoard id="likes-board" {items} assetURL={item => api.assetURL(item)}
      emptyMessage={selectedCollection ? 'No published items in this collection.' : 'No published items to show.'} />
    {nextCursor && <nav aria-label="Likes pagination"><a href={boardURL(selectedCollection, nextCursor)}>Older items</a></nav>}
  </>
)}

<style>
  #collection-filters { display: flex; flex-wrap: wrap; gap: .75rem; margin-block: 1rem; }
  #collection-filters [aria-current="page"] { font-weight: bold; text-decoration: underline; }
</style>
