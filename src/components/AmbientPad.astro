---
import { pads } from '../lib/ambient-kit';
import PadIcon from './PadIcon.astro';
---

<section id="ambient-pad" aria-label="Ambient playground">
  <div class="controller">
    <p class="sr-only" role="status" aria-atomic="true" data-status>Ready. Play a pad or record a loop.</p>
    <p class="sr-only" data-loop-info>No loop yet</p>
    <div class="pads" aria-label="Sound pads">
      {pads.map((pad, index) => (
        <button type="button" data-pad={pad.id} aria-label={`Pad ${index + 1}, ${pad.label}`} disabled>
          <span class="pad-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span>{pad.label}</span>
        </button>
      ))}
    </div>
    <div class="controls" role="group" aria-label="Volume and looper controls">
      <button type="button" class="record" data-record aria-label="Record" title="Record" disabled>
        <span data-record-icon="record"><PadIcon name="circle" /></span>
        <span data-record-icon="overdub" hidden><PadIcon name="repeat" /></span>
      </button>
      <button type="button" data-play aria-label="Play" title="Play" disabled>
        <span data-play-icon="play"><PadIcon name="play" /></span>
        <span data-play-icon="stop" hidden><PadIcon name="stop" /></span>
      </button>
      <button type="button" data-mute aria-label="Mute" title="Mute" aria-pressed="false" disabled><PadIcon name="volume-x" /></button>
      <button type="button" data-clear aria-label="Clear" title="Clear" disabled><PadIcon name="trash" /></button>
    </div>
    <label class="volume-fader" title="Volume: drag up or down, or use arrow keys">
      <span class="sr-only">Volume</span>
      <input type="range" data-volume min="0" max="100" step="1" value="60" aria-orientation="vertical" aria-valuetext="60 percent" disabled />
    </label>
  </div>
  <noscript><p>This instrument needs JavaScript and Web Audio. The rest of the site works without them.</p></noscript>
</section>

<script>
  import '../scripts/ambient-pad';
</script>

<style>
  #ambient-pad { width: min(100%, 26rem); text-align: left; color: var(--nord4); }
  .controller { display: grid; grid-template-columns: minmax(0, 1fr) 44px 44px; gap: 0.5rem; border: 1px solid var(--nord8); border-radius: 0.65rem; background: var(--nord1); padding: 0.5rem; }
  button { font: inherit; color: var(--nord6); border: 1px solid var(--nord4); border-radius: 0.25rem; background: var(--nord0); min-height: 44px; padding: 0.3rem; cursor: pointer; }
  button:disabled { opacity: 0.55; cursor: default; }
  button:not(:disabled):hover { border-color: var(--nord8); }
  button:focus-visible { outline: 2px solid var(--nord13); outline-offset: 3px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  [data-status]:not(.sr-only) { grid-column: 1 / -1; margin: 0; }
  .pads { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; }
  .pads button { min-width: 0; display: flex; flex-direction: column; justify-content: space-between; text-align: left; color: var(--nord0); background: var(--nord8); border-color: transparent; touch-action: none; user-select: none; -webkit-user-select: none; }
  .pads button:nth-child(n+5) { background: var(--nord7); }
  .pads button:nth-child(n+9) { background: var(--nord14); }
  .pads button:nth-child(n+13) { background: var(--nord13); }
  .pads button span:last-child { align-self: end; }
  .pad-number { font-size: 11px; }
  .pads button:not(:disabled):is(:active, [data-held]) { outline: 2px solid var(--nord6); outline-offset: 2px; background: var(--nord6); }
  .controls { display: grid; gap: 0.5rem; }
  .controls button, .controls span:not([hidden]) { display: grid; place-items: center; }
  .volume-fader { position: relative; min-height: 44px; border-radius: 0.25rem; background: var(--nord0); }
  .volume-fader input { position: absolute; inset: 0; box-sizing: border-box; width: 100%; height: 100%; margin: 0; padding: 8px 0; writing-mode: vertical-lr; direction: rtl; appearance: none; background: transparent; cursor: ns-resize; }
  .volume-fader input::-webkit-slider-runnable-track { width: 8px; height: 100%; border: 1px solid var(--nord3); border-radius: 4px; background: #161a20; box-shadow: inset 1px 0 3px #000; }
  .volume-fader input::-moz-range-track { width: 8px; height: 100%; border: 1px solid var(--nord3); border-radius: 4px; background: #161a20; box-shadow: inset 1px 0 3px #000; }
  .volume-fader input::-webkit-slider-thumb { appearance: none; width: 34px; height: 16px; margin-left: -14px; border: 1px solid var(--nord3); border-radius: 3px; background: linear-gradient(to bottom, var(--nord6), var(--nord4) 40%, var(--nord0) 42%, var(--nord0) 58%, var(--nord4) 60%, var(--nord6)); box-shadow: 0 2px 3px #0008; }
  .volume-fader input::-moz-range-thumb { width: 34px; height: 16px; border: 1px solid var(--nord3); border-radius: 3px; background: linear-gradient(to bottom, var(--nord6), var(--nord4) 40%, var(--nord0) 42%, var(--nord0) 58%, var(--nord4) 60%, var(--nord6)); box-shadow: 0 2px 3px #0008; }
  .volume-fader input:focus-visible { outline: 2px solid var(--nord13); outline-offset: 3px; border-radius: 0.25rem; }
  .volume-fader input:disabled { opacity: 0.55; cursor: default; }
  @media (max-width: 400px) {
    .controller { gap: 0; padding: 0; }
    .pads { gap: 1px; }
  }
  .record { border-color: var(--nord15); }
  [data-recording] .record { background: var(--nord11); border-style: dashed; }
  [aria-pressed=true] { background: var(--nord8); color: var(--nord0); }
</style>
