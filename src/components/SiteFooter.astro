---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <p>&copy; {year}</p>
    <div class="footer-badges">
      <img src="/images/Censor_Gc.gif" alt="Web rated G" width="100" height="35" loading="lazy" />
      <img src="/images/website-copy-1.gif" alt="Website" width="88" height="31" loading="lazy" />
      <img src="/images/button471.png" alt="Under construction" width="88" height="31" loading="lazy" />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    border-block-start: 1px solid var(--ink-700);
    padding: 0.5em 1.5rem;
    margin-top: 8rem;
    padding-block-end: max(2rem, env(safe-area-inset-bottom));
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: auto;
  }


  @media (width >= 48rem) {
    .site-footer {
      display: grid;
      grid-template-columns: subgrid;
      padding-inline: 0;
    }

    .footer-content {
      grid-column: 2;
      max-width: none;
      margin: 0;
      /* Match the header's width, border and inline padding. */
      width: 29rem;
      padding-inline: calc(1.625rem + 1px) calc(2rem + 1px);
    }
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  img {
    flex-shrink: 0;
  }

  p {
    margin-block: 1.5rem;
    color: var(--colour-text-muted);
    font-size: 0.875rem;
  }
</style>
