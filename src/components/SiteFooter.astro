---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <p>&copy; {year}</p>
    <div class="footer-badges">
      <button class="construction-toggle" type="button" popovertarget="construction-worker" aria-label="Under construction: toggle construction worker">
        <img src="/images/button471.png" alt="Under construction" width="88" height="31" loading="lazy" />
      </button>
      <a href="/rss.xml" data-astro-reload>
        <img src="/images/rss-button.gif" alt="RSS Feed" width="88" height="31" loading="lazy" />
      </a>
    </div>
  </div>
  <div class="footer-end">
    <img class="the-end" src="/images/the-end.gif" alt="The End" width="230" height="20" loading="lazy" />
  </div>
</footer>

<div id="construction-worker" class="construction-worker" popover="manual">
  <picture aria-hidden="true">
    <source srcset="/images/construction-worker.png" media="(prefers-reduced-motion: reduce)" />
    <img src="/images/construction-worker.gif" alt="" width="200" height="226" loading="lazy" />
  </picture>
</div>

<style>
  .site-footer {
    width: 100%;
    border-block-start: 1px solid var(--ink-700);
    padding: 0.5em 1.5rem;
    margin-top: 8rem;
    padding-block-end: max(2rem, env(safe-area-inset-bottom));
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: auto;
  }


  @media (width >= 48rem) {
    .site-footer {
      grid-column: 2;
      max-width: calc(100% - 3rem);
      padding-inline: 0;
    }

    .footer-content {
      max-width: none;
      margin: 0;
      width: 100%;
    }
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .construction-toggle {
    display: flex;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .construction-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .construction-worker {
    position: fixed;
    inset: auto max(0px, env(safe-area-inset-right)) max(0px, env(safe-area-inset-bottom)) auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    pointer-events: none;
  }

  .construction-worker img {
    display: block;
    width: 200px;
    height: auto;
    image-rendering: pixelated;
  }

  .footer-badges a {
    --link-lift: 0px;
    display: flex;
  }

  .footer-badges a::before {
    display: none;
  }

  .footer-badges img {
    display: block;
    width: 88px;
    height: 31px;
  }

  .footer-end {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 0.5rem;
  }

  .the-end {
    display: block;
    width: 230px;
    height: auto;
    max-width: 100%;
  }

  img {
    flex-shrink: 0;
  }

  p {
    margin-block: 1.5rem;
    color: var(--colour-text-muted);
    font-size: 0.875rem;
  }
</style>
