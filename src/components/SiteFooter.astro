---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-content">
    <p>&copy; {year}</p>
    <div class="footer-badges">
      <img src="/images/button471.png" alt="Under construction" width="88" height="31" loading="lazy" />
      <a href="/rss.xml" data-astro-reload>
        <img src="/images/rss-button.gif" alt="RSS Feed" width="88" height="31" loading="lazy" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    border-block-start: 1px solid var(--ink-700);
    padding: 0.5em 1.5rem;
    margin-top: 8rem;
    padding-block-end: max(2rem, env(safe-area-inset-bottom));
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: auto;
  }


  @media (width >= 48rem) {
    .site-footer {
      grid-column: 2;
      max-width: calc(100% - 3rem);
      padding-inline: 0;
    }

    .footer-content {
      max-width: none;
      margin: 0;
      width: 100%;
    }
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .footer-badges a {
    --link-lift: 0px;
    display: flex;
  }

  .footer-badges a::before {
    display: none;
  }

  img {
    flex-shrink: 0;
  }

  p {
    margin-block: 1.5rem;
    color: var(--colour-text-muted);
    font-size: 0.875rem;
  }
</style>
