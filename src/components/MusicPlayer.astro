---
import { stat } from 'node:fs/promises';
import { publicDir } from 'astro:config/server';
import CassetteRecorder from './CassetteRecorder.astro';
import PixelBox from './elements/PixelBox.astro';

interface Props {
  id?: string;
  title: string;
  artist?: string;
  showHeader?: boolean;
  tracks: { title: string; src: string }[];
}

const { id, title, artist, tracks, showHeader = true } = Astro.props;
const [first] = tracks;
for (const track of tracks) {
  if (!track.src.startsWith('/audio/')) continue;
  const file = await stat(new URL(`.${track.src}`, publicDir)).catch(() => undefined);
  if (!file?.isFile()) throw new Error(`Music player "${title}": missing audio file "${track.src}"`);
}
---

{first && <section {id} class="music-player" aria-label={`Listen to ${title}`}>
  {showHeader && <header><h2>{title}</h2>{artist && <p>{artist}</p>}</header>}
  <music-deck data-state="stopped">
    <audio controls preload="none" src={first.src} aria-label={first.title}></audio>
    <div data-fallback>
      {tracks.map(track => <a href={track.src} download>Download {track.title}</a>)}
    </div>
    <div data-recorder hidden>
      <CassetteRecorder {...first} />
      <p class="error" role="status" hidden>Unable to play this track. Try downloading the MP3.</p>
      {tracks.length > 1 && <PixelBox class="track-index">
        <div class="legend"><span>Track index</span><span>{String(tracks.length).padStart(2, '0')} tracks</span></div>
        <ol aria-label="Load a track">
          {tracks.map((track, i) => <li><button type="button" data-src={track.src} data-label={track.title} aria-label={`Load ${track.title}`} aria-current={i === 0 ? 'true' : undefined}>
            <span class="number">{String(i + 1).padStart(2, '0')}</span><span>{track.title}</span><span class="loaded" aria-hidden="true">Loaded</span>
          </button></li>)}
        </ol>
      </PixelBox>}
    </div>
  </music-deck>
</section>}

<script>
  class MusicDeck extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const audio = this.querySelector('audio')!;
      const play = this.querySelector<HTMLButtonElement>('[data-play]')!;
      const pause = this.querySelector<HTMLButtonElement>('[data-pause]')!;
      const mute = this.querySelector<HTMLButtonElement>('[data-mute]')!;
      const download = this.querySelector<HTMLAnchorElement>('[data-download]')!;
      const error = this.querySelector<HTMLElement>('.error')!;
      const time = this.querySelector<HTMLElement>('[data-time]')!;
      const choices = this.querySelectorAll<HTMLButtonElement>('button[data-src]');

      const wheels = this.querySelectorAll<HTMLElement>('[data-wheel]');
      const motion = matchMedia('(prefers-reduced-motion: no-preference)');
      let lastSecond = 0;
      let frame = 0;
      const updateCounter = () => {
        const position = audio.currentTime;
        const seconds = Math.floor(position);
        wheels.forEach((strip, i) => {
          const place = 10 ** (wheels.length - 1 - i);
          if (seconds !== lastSecond) {
            const digit = Math.floor(seconds / place) % 10;
            strip.children[0].textContent = String(digit);
            strip.children[1].textContent = String((digit + 1) % 10);
          }
          // The units drum turns continuously; higher drums engage during the last unit of a carry.
          const engaged = seconds % place === place - 1;
          if (engaged || seconds !== lastSecond) {
            strip.style.setProperty('--roll', `${engaged ? -50 * (position - seconds) : 0}%`);
          }
        });
        if (seconds !== lastSecond) {
          time.textContent = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
          lastSecond = seconds;
        }
        if (!frame && !audio.paused && this.isConnected && motion.matches) {
          frame = requestAnimationFrame(() => { frame = 0; updateCounter(); });
        }
      };

      const stop = () => {
        this.dataset.state = 'stopped';
        audio.pause();
        audio.currentTime = 0;
        updateCounter();
      };
      play.addEventListener('click', async () => {
        error.hidden = true;
        try { await audio.play(); }
        catch (e) { if (!(e instanceof DOMException && e.name === 'AbortError')) error.hidden = false; }
      });
      pause.addEventListener('click', () => audio.pause());
      this.querySelector('[data-stop]')!.addEventListener('click', stop);
      mute.addEventListener('click', () => { audio.muted = !audio.muted; });
      audio.addEventListener('volumechange', () => mute.setAttribute('aria-pressed', String(audio.muted)));
      audio.addEventListener('play', () => {
        if (audio.paused) return;
        this.dataset.state = 'playing';
        for (const other of document.querySelectorAll<HTMLAudioElement>('music-deck audio')) {
          if (other !== audio) other.pause();
        }
      });
      audio.addEventListener('pause', () => {
        // Stop and track changes also emit pause; neither should latch the Pause key.
        if (audio.paused && this.dataset.state === 'playing') this.dataset.state = 'paused';
      });
      audio.addEventListener('ended', stop);
      audio.addEventListener('error', () => { this.dataset.state = 'stopped'; error.hidden = false; });
      audio.addEventListener('playing', updateCounter);
      audio.addEventListener('timeupdate', updateCounter);
      choices.forEach((choice, index) => choice.addEventListener('click', () => {
        stop();
        error.hidden = true;
        const title = choice.dataset.label!;
        audio.src = choice.dataset.src!;
        audio.setAttribute('aria-label', title);
        audio.load();
        this.querySelector('[data-title]')!.textContent = title;
        this.querySelector('[data-number]')!.textContent = String(index + 1).padStart(2, '0');
        download.href = audio.src;
        download.setAttribute('aria-label', `Download ${title} (MP3)`);
        for (const other of choices) other.removeAttribute('aria-current');
        choice.setAttribute('aria-current', 'true');
      }));

      audio.controls = false;
      audio.hidden = true;
      this.querySelector<HTMLElement>('[data-fallback]')!.hidden = true;
      this.querySelector<HTMLElement>('[data-recorder]')!.hidden = false;
      this.dataset.ready = 'true';
    }
    disconnectedCallback() { this.querySelector('audio')?.pause(); }
  }
  if (!customElements.get('music-deck')) customElements.define('music-deck', MusicDeck);
</script>

<style>
  .music-player { width: min(100%, 380px); margin-inline: auto; text-align: left; scroll-margin-block-start: 6rem; }
  header { margin-bottom: .75rem; }
  h2 { margin: 0; }
  header p, .error { color: var(--nord4); font-size: .875rem; }
  music-deck, audio, [data-fallback] a { display: block; }
  audio { width: 100%; }
  [hidden] { display: none !important; }
  [data-recorder] { display: grid; gap: 1rem; }
  .legend { display: flex; justify-content: space-between; padding: .45rem .85rem; font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: var(--nord4); border-bottom: 2px solid #171c25; }
  ol { list-style: none; margin: 0; padding: .2rem; }
  li + li { border-top: 1px solid var(--nord3); }
  li button { display: grid; grid-template-columns: 2ch 1fr auto; gap: .8rem; align-items: center; width: 100%; min-height: 2.75rem; padding: .4rem .65rem; border: 0; border-left: 3px solid transparent; background: transparent; color: var(--nord6); text-align: left; font: inherit; cursor: var(--cursor-pointer); }
  .number, .loaded { color: var(--nord4); font-size: .75rem; }
  .loaded { display: none; color: var(--nord8); }
  button[aria-current] { border-left-color: var(--nord8); background: var(--nord0); }
  button[aria-current] .loaded { display: inline; }
  li button:hover { background: var(--nord3); }
  li button:focus-visible { outline: 2px solid var(--nord8); outline-offset: -2px; }
</style>
