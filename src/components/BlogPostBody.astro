---
import { render, type CollectionEntry } from 'astro:content';
import MusicPlayer from './MusicPlayer.astro';

interface Props {
  post: CollectionEntry<'blog' | 'musicJournal'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

{post.collection === 'musicJournal' && <MusicPlayer title={post.data.title} showHeader={false} fullWidth tracks={[post.data.track]} />}
<Content />
