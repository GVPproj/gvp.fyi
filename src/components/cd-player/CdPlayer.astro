---
import Rack from './Rack.astro';

interface Track { title: string; src: string }
interface Props { tracks: readonly Track[] }
const { tracks } = Astro.props;
const controls = [
  ['previous', 'Previous track', 'M1 2h2v10H1zm10 0v10H9v-2H6V8H4V6h2V4h3V2z'],
  ['play', 'Play', 'M2 1h2v2h3v2h3v1h2v2h-2v1H7v2H4v2H2z'],
  ['pause', 'Pause', 'M2 2h4v10H2zm6 0h4v10H8z'],
  ['stop', 'Stop', 'M2 2h10v10H2z'],
  ['next', 'Next track', 'M11 2h2v10h-2zM3 2h2v2h3v2h2v2H8v2H5v2H3z'],
];
---
{tracks.length > 0 && <section class="cd-player" aria-label="Music Journal CD player">
  <div data-face hidden>
    <Rack>
      <div slot="display" class="lcd">
        <small>TRACK</small><small data-mode>STOP</small>
        <b data-track>01</b><b data-time>0:00</b>
        <span class="track-title" role="status">{tracks[0].title}</span>
      </div>
      <div slot="keys" class="keys">{controls.map(([action,label,d]) => (
        <button type="button" data-action={action} aria-label={label} title={label}>
          <svg viewBox="0 0 14 14" aria-hidden="true" shape-rendering="crispEdges"><path d={d}/></svg>
        </button>
      ))}</div>
    </Rack>
  </div>
  <div data-fallback>
    <ol>{tracks.map(({title, src}) => <li>
      <a href={src}>{title}</a>
      <audio controls preload="none" src={src} aria-label={`Music Journal: ${title}`}></audio>
    </li>)}</ol>
  </div>
</section>}
<style>
  .cd-player { --transport-height:30px; width:100%; min-width:0; }
  audio { max-width:100%; }
  .track-title { grid-column:1 / -1; align-self:end; padding-top:.5em; line-height:1.2; overflow-wrap:anywhere; }
  .lcd { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); grid-template-rows:auto auto 1fr; gap:2px 4px; min-height:4.75rem; box-sizing:border-box; background:var(--lcd-bg); color:var(--lcd-ink); font-family:'Gohu',monospace; text-align:left; line-height:1; padding:4px; }
  small { font-size:9px; letter-spacing:.06em; }
  b { font-size:clamp(16px,3vw,30px); font-weight:400; white-space:nowrap; }
  .keys { display:flex; gap:3px; }
  .keys button { flex:1; min-width:0; min-height:var(--transport-height); color:var(--key-ink); background:var(--key-face); border:2px solid; border-color:#888892 #17171c #141419 #65656b; box-shadow:0 2px #111; padding:3px; }
  .keys svg { vertical-align:middle; width:12px; fill:currentColor; }
  .keys button:enabled:hover {filter:brightness(1.2)}
  .keys button:disabled {color:#afabb0}
  .keys button:active {border-style:inset; transform:translateY(1px)}
  .keys button:focus-visible {outline:2px solid #ffdc91;outline-offset:2px;position:relative;z-index:1}
</style>
<script>
  import { setPath, wireUp, press, release } from 'button-sounds';
  import { stereoMeter } from './stereo-meter';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.cd-player').forEach(enhance);
  });

  function enhance(deck: HTMLElement) {
    const face = deck.querySelector<HTMLElement>('[data-face]')!;
    if (!face.hidden) return;
    const playlist = deck.querySelectorAll<HTMLAnchorElement>('[data-fallback] a');
    let currentIndex = 0;
    const previous = deck.querySelector<HTMLButtonElement>('[data-action=previous]')!;
    const next = deck.querySelector<HTMLButtonElement>('[data-action=next]')!;
    const trackNumber = deck.querySelector('[data-track]')!;
    const trackTitle = deck.querySelector('.track-title')!;
    const audio = deck.querySelector('audio')!;
    const meter = stereoMeter(audio, [...deck.querySelectorAll<SVGGElement>('[data-meter-bank]')]);
    const buttons = [...deck.querySelectorAll<HTMLButtonElement>('[data-action]')];
    const mode = deck.querySelector('[data-mode]')!;
    const time = deck.querySelector('[data-time]')!;
    const controller = new AbortController();
    const { signal } = controller;
    setPath('/audio/transport');
    const preset = 'uhk-soft';
    const opts = { volume: 0.5, lofi: false, pitchVariation: 0.1 };
    const clean = buttons.map(button => wireUp(button, preset, opts));
    function keySound(trigger: typeof press) {
      if (!signal.aborted) trigger(preset, { ...opts, playbackRate: 1 + (Math.random()*2 - 1)*opts.pitchVariation });
    }
    function render() {
      const seconds = Math.floor(audio.currentTime);
      time.textContent = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
      mode.textContent = audio.error ? 'ERR' : !audio.paused ? 'PLAY' : audio.currentTime ? 'PAUSE' : 'STOP';
    }
    function play() {
      meter.activate();
      audio.play().catch(error => { if (error.name !== 'AbortError') mode.textContent = 'ERR'; });
    }
    function selectTrack(index: number, resume: boolean) {
      const track = playlist[index];
      if (!track) return;
      currentIndex = index;
      audio.ariaLabel = `Music Journal: ${track.text}`;
      audio.src = track.href;
      audio.load();
      previous.disabled = index === 0;
      next.disabled = index === playlist.length - 1;
      trackNumber.textContent = String(index + 1).padStart(2, '0');
      trackTitle.textContent = track.text;
      render();
      if (resume) play();
    }
    function stop() { audio.pause(); audio.currentTime = 0; render(); }
    buttons.forEach(button => button.addEventListener('click', event => {
      if (!event.detail) { keySound(press); setTimeout(() => keySound(release), 90); }
      switch (button.dataset.action) {
        case 'play': play(); break;
        case 'pause': audio.pause(); break;
        case 'stop': stop(); break;
        case 'previous': selectTrack(currentIndex - 1, !audio.paused); break;
        case 'next': selectTrack(currentIndex + 1, !audio.paused); break;
      }
    }, { signal }));
    for (const event of ['timeupdate', 'play', 'pause', 'error']) audio.addEventListener(event, render, { signal });
    audio.addEventListener('ended', () => {
      if (currentIndex + 1 < playlist.length) selectTrack(currentIndex + 1, true);
      else stop();
    }, { signal });
    // Play only one deck at a time.
    document.addEventListener('play', event => {
      if (event.target === audio) document.querySelectorAll<HTMLAudioElement>('music-deck audio').forEach(other => other.pause());
      else if (event.target instanceof HTMLAudioElement && event.target.closest('music-deck, .cd-player')) audio.pause();
    }, { capture: true, signal });
    previous.disabled = true;
    next.disabled = playlist.length === 1;
    deck.querySelector<HTMLElement>('[data-fallback]')!.hidden = true;
    face.hidden = false;
    document.addEventListener('astro:before-swap', () => {
      controller.abort(); audio.pause(); meter.dispose(); clean.forEach(remove => remove());
    }, { once: true });
  }
</script>
