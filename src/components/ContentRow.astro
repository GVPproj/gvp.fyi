---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface ContentRowItem {
  href: string;
  title: string;
  image?: ImageMetadata;
  text?: string;
  label?: string;
  subtitle?: string;
  metadata?: string;
}

interface Props {
  id: string;
  title: string;
  summary: string;
  items: ContentRowItem[];
}
const { id, title, summary, items } = Astro.props;
const heading = `${id}-heading`;
---

<section class="content-row" aria-labelledby={heading}>
  <div class="content-row-info">
    <h2 id={heading}>{title}</h2>
    <p>{summary}</p>
  </div>
  <ul id={`${id}-items`} aria-label={`${title} items`}>
    {items.map(item => (
      <li>
        <a href={item.href}>
          <div class:list={['content-preview', { 'text-preview': item.text !== undefined }]}>
            {item.image ? (
              <Image src={item.image} width={Math.min(320, item.image.width)} layout="constrained" sizes="192px" alt="" />
            ) : <span>{item.text ?? item.label ?? item.title}</span>}
          </div>
          <span class="content-title">{item.title}</span>
          {item.subtitle && <span class="subtitle">{item.subtitle}</span>}
          {item.metadata && <span class="item-metadata">{item.metadata}</span>}
        </a>
      </li>
    ))}
    {!items.length && <li class="empty-preview">No published items yet</li>}
  </ul>
  {items.length > 14 && (
    <button type="button" class="load-more" aria-controls={`${id}-items`} aria-label={`Load more ${title} items`} hidden>
      Load more…
    </button>
  )}
</section>

<script>
  function initializeRows() {
    const batchSize = 14;
    document.querySelectorAll<HTMLElement>('.content-row').forEach(row => {
      const button = row.querySelector<HTMLButtonElement>('.load-more');
      if (!button) return;
      const cards = Array.from(row.querySelectorAll<HTMLElement>('ul > li'));
      let visibleCount = batchSize;
      cards.forEach((card, index) => { card.hidden = index >= visibleCount; });
      button.hidden = false;
      button.onclick = () => {
        const firstNewCard = cards[visibleCount];
        visibleCount += batchSize;
        cards.forEach((card, index) => { card.hidden = index >= visibleCount; });
        button.hidden = visibleCount >= cards.length;
        firstNewCard?.querySelector('a')?.focus({ preventScroll: true });
      };
    });

    // Match only the first card row, not the full height of the wrapping grid.
    const observer = new ResizeObserver(entries => {
      for (const { target } of entries) {
        const row = target.closest<HTMLElement>('.content-row');
        const cards = (Array.from(target.children) as HTMLElement[]).filter(card => !card.hidden);
        const firstTop = cards[0]?.offsetTop;
        const firstRowHeight = Math.max(0, ...cards
          .filter(card => card.offsetTop === firstTop)
          .map(card => card.getBoundingClientRect().height));
        const style = getComputedStyle(target);
        const padding = parseFloat(style.paddingTop) + parseFloat(style.paddingBottom);
        row?.style.setProperty('--first-row-height', `${firstRowHeight + padding}px`);
      }
    });
    document.querySelectorAll('.content-row > ul').forEach(list => observer.observe(list));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', initializeRows);
</script>

<style>
  .content-row {
    --preview-size: clamp(8rem, 16vw, 12rem);
    display: grid;
    grid-template-columns: clamp(7rem, 18vw, 12rem) minmax(0, 1fr);
    gap: .75rem;
    padding: .75rem;
    border: 1px solid var(--nord3);
    color: var(--color-foreground);
  }
  .content-row-info { display: flex; flex-direction: column; justify-content: center; align-self: start; min-height: var(--first-row-height, var(--preview-size)); text-align: center; overflow-wrap: anywhere; }
  h2 { font-size: clamp(1rem, 1.6vw, 1.25rem); font-weight: 400; line-height: 1.3; margin: 0 0 .5rem; }
  p { margin: 0; color: var(--nord4); font-size: .8rem; line-height: 1.5; }
  ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--preview-size)), 1fr)); gap: .75rem; min-width: 0; list-style: none; padding: .25rem; margin: 0; }
  li { min-width: 0; }
  a { display: block; color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  li a { font-size: .85rem; line-height: 1.5; }
  .content-title, .subtitle, .item-metadata { display: block; }
  .subtitle, .item-metadata { margin-top: .25rem; }
  .item-metadata { color: var(--nord4); font-size: .8rem; }
  a:hover .content-title, a:hover .subtitle, a:hover .item-metadata { text-decoration: underline; }
  a:focus-visible, .load-more:focus-visible { outline: 2px solid var(--nord8); outline-offset: 2px; }
  .load-more { grid-column: 2; justify-self: start; margin: .25rem; padding: .5rem .75rem; border: 1px solid var(--nord3); background: var(--nord1); color: inherit; font: inherit; font-size: .85rem; cursor: var(--cursor-pointer); }
  .load-more:hover { border-color: var(--nord8); }
  .content-preview { display: flex; align-items: center; justify-content: center; width: 100%; aspect-ratio: 1; overflow: hidden; background: var(--nord1); margin-bottom: .5rem; color: var(--nord4); }
  .content-preview img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .content-preview > span { padding: 1rem; overflow-wrap: anywhere; }
  .text-preview { display: block; white-space: pre-wrap; }
  .text-preview > span { display: block; }
  .empty-preview { grid-column: 1 / -1; align-self: start; color: var(--nord4); font-size: .85rem; }
  @media (max-width: 30rem) {
    .content-row { grid-template-columns: minmax(0, 1fr); }
    .content-row-info { min-height: 0; text-align: left; }
    .load-more { grid-column: 1; }
  }
</style>
