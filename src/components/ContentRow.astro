---
import { Image } from 'astro:assets';

export interface ContentRowItem {
  href: string;
  title: string;
  image?: { src: string; width: number; height: number; optimized?: boolean };
  text?: string;
  label?: string;
  subtitle?: string;
  metadata?: string;
}

interface Props {
  id: string;
  title: string;
  summary: string;
  items: ContentRowItem[];
  headingHref?: string;
}
const { id, title, summary, items, headingHref } = Astro.props;
const heading = `${id}-heading`;
---

<section class="content-row" aria-labelledby={heading}>
  <div class="content-row-info">
    <h2 id={heading}>{headingHref ? <a href={headingHref}>{title}</a> : title}</h2>
    <p>{summary}<slot name="metadata" /></p>
  </div>
  <ul aria-label={`${title} items`}>
    {items.map(item => (
      <li>
        <a href={item.href}>
          <div class:list={['content-preview', { 'text-preview': item.text !== undefined }]}>
            {item.image ? item.image.optimized ? (
              <Image src={item.image.src} alt="" width={320} height={320} widths={[160, 320, 640]} sizes="192px" fit="contain" format="webp" loading="lazy" />
            ) : (
              <img src={item.image.src} alt="" width={item.image.width} height={item.image.height} loading="lazy" />
            ) : <span>{item.text ?? item.label ?? item.title}</span>}
          </div>
          <span class="content-title">{item.title}</span>
          {item.subtitle && <span class="subtitle">{item.subtitle}</span>}
          {item.metadata && <span class="item-metadata">{item.metadata}</span>}
        </a>
      </li>
    ))}
    {!items.length && <li class="empty-preview">No published items yet</li>}
  </ul>
</section>

<style>
  .content-row {
    --preview-size: clamp(8rem, 16vw, 12rem);
    display: grid;
    grid-template-columns: clamp(7rem, 18vw, 12rem) minmax(0, 1fr);
    gap: .75rem;
    padding: .75rem;
    border: 1px solid var(--nord3);
    color: var(--color-foreground);
  }
  .content-row-info { display: flex; flex-direction: column; justify-content: center; text-align: center; overflow-wrap: anywhere; }
  h2 { font-size: clamp(1rem, 1.6vw, 1.25rem); font-weight: 400; line-height: 1.3; margin: 0 0 .5rem; }
  p { margin: 0; color: var(--nord4); font-size: .8rem; line-height: 1.5; }
  ul { display: flex; gap: .75rem; overflow-x: auto; scroll-snap-type: x proximity; min-width: 0; list-style: none; padding: .25rem; margin: 0; }
  li { flex: 0 0 var(--preview-size); min-width: 0; scroll-snap-align: start; }
  a { display: block; color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  li a { font-size: .85rem; line-height: 1.5; }
  .content-title, .subtitle, .item-metadata { display: block; }
  .subtitle, .item-metadata { margin-top: .25rem; }
  .item-metadata { color: var(--nord4); font-size: .8rem; }
  a:hover .content-title, a:hover .subtitle, a:hover .item-metadata, h2 a:hover { text-decoration: underline; }
  a:focus-visible { outline: 2px solid var(--nord8); outline-offset: 2px; }
  .content-preview { display: flex; align-items: center; justify-content: center; width: 100%; aspect-ratio: 1; overflow: hidden; background: var(--nord1); margin-bottom: .5rem; color: var(--nord4); }
  .content-preview img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .content-preview > span { padding: 1rem; overflow-wrap: anywhere; }
  .text-preview { display: block; white-space: pre-wrap; }
  .text-preview > span { display: block; }
  .empty-preview { flex-basis: auto; align-self: center; color: var(--nord4); font-size: .85rem; }
  @media (max-width: 30rem) {
    .content-row { grid-template-columns: minmax(0, 1fr); }
    .content-row-info { text-align: left; }
  }
</style>
