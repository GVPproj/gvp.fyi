---
interface Props { open?: boolean }
const { open = false } = Astro.props
---

<!-- Pixel “Tetris Drop” menu from unbusy.day. -->
<span class:list={['menu-pixel', { open }]} aria-hidden="true">
  {[0, 1, 2].map(() => <span class="trow">{[0, 1, 2, 3].map(() => <i />)}</span>)}
</span>

<style>
  .menu-pixel { display: block; position: relative; width: 24px; height: 24px; image-rendering: pixelated; }
  .trow {
    position: absolute;
    inset-inline: 1px;
    top: 50%;
    height: 4px;
    margin-top: -2px;
    display: flex;
    gap: 1px;
    justify-content: space-between;
    transition: transform 0.3s steps(3), opacity 0.2s;
  }
  .trow:nth-child(1) { transform: translateY(-7px); }
  .trow:nth-child(3) { transform: translateY(7px); }
  i { width: 4px; height: 4px; background: currentColor; animation: menu-drop 2.6s steps(5) 1 both; }
  .trow:nth-child(1) i:nth-child(2) { animation-delay: 0.1s; }
  .trow:nth-child(1) i:nth-child(3) { animation-delay: 0.2s; }
  .trow:nth-child(1) i:nth-child(4) { animation-delay: 0.3s; }
  .trow:nth-child(2) i { animation-delay: 0.45s; }
  .trow:nth-child(3) i { animation-delay: 0.7s; }
  .open .trow:nth-child(1) { transform: rotate(45deg); }
  .open .trow:nth-child(2) { transform: scaleX(0); opacity: 0; }
  .open .trow:nth-child(3) { transform: rotate(-45deg); }
  .open i { animation: none; }
  @keyframes menu-drop {
    0% { transform: translateY(-18px); opacity: 0; }
    12% { opacity: 1; }
    28%, 100% { transform: translateY(0); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    i { animation: none; }
    .trow { transition: none; }
  }
</style>
