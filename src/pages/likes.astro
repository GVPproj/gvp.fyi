---
import Layout from '../layouts/Layout.astro';
import OwnerTools from '../components/likes/owner-tools/OwnerTools.astro';
import PublishedItems from '../components/likes/PublishedItems.astro';
import SessionRecovery from '../components/likes/SessionRecovery.astro';
import TextReader from '../components/likes/TextReader.astro';
import ImageViewer from '../components/likes/ImageViewer.astro';
import '../styles/likes.css';

const endpoint = import.meta.env.PUBLIC_POCKETBASE_URL ?? '';
---

<Layout title="Likes" wide clientRouter={false}>
  <section id="likes" data-endpoint={endpoint}>
    <h1>Likes</h1>
    <SessionRecovery />
    <OwnerTools />
    <PublishedItems />
    <TextReader />
    <ImageViewer />
  </section>
</Layout>

<script>
  import '../scripts/likes.js';
</script>

<style>
  :global(main.likes-layout) { justify-content: flex-start; text-align: left; max-width: 90rem; }
  #likes { width: 100%; }
  #likes h1 { margin-bottom: 1rem; }
</style>
