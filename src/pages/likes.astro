---
import Layout from '../layouts/Layout.astro';
const endpoint = import.meta.env.PUBLIC_POCKETBASE_URL ?? '';
---

<Layout title="Likes" wide clientRouter={false}>
  <section id="likes" data-endpoint={endpoint}>
    <h1>Likes</h1>
    <details class="owner-tools">
      <summary>Owner sign in / edit Likes</summary>
      <form id="owner-login">
        <label>Email <input name="email" type="email" autocomplete="username" required /></label>
        <label>Password <input name="password" type="password" autocomplete="current-password" required /></label>
        <button>Sign in</button>
      </form>
      <p id="auth-status" role="status"></p>
      <button id="sign-out" type="button" hidden>Sign out</button>
      <button id="reauthenticate" type="button" hidden>Sign in again (keep edits)</button>
      <form id="save-link" hidden>
        <h2 id="editor-title">Save an item</h2>
        <label>Destination / source URL (optional for uploads) <input name="url" type="url" placeholder="https://" maxlength="2048" /></label>
        <label>Image or PDF <input name="asset" type="file" accept=".jpg,.jpeg,.png,.gif,.webp,.pdf" aria-describedby="upload-limits" /></label>
        <p id="upload-limits">JPEG, PNG, GIF, WebP or PDF; maximum 10 MiB. Uploaded only when you save. Selecting a file replaces the current upload.</p>
        <p id="current-asset"></p>
        <label><input name="removeAsset" type="checkbox" /> Remove current upload (a destination URL is then required)</label>
        <label>Title <input name="title" required maxlength="300" /></label>
        <label>Description <textarea name="description" maxlength="5000"></textarea></label>
        <label>Commentary <textarea name="commentary" maxlength="10000"></textarea></label>
        <fieldset><legend>Named collections (optional)</legend><div id="item-collections"></div></fieldset>
        <label><input name="draft" type="checkbox" /> Save as draft (owner only)</label>
        <p id="draft-warning">Returning a published item to draft hides it from future public reads. Previously downloaded or cached content cannot be made secret retroactively.</p>
        <button>Save item</button>
        <button id="new-item" type="button">Cancel / new item</button>
        <button id="delete-item" type="button" hidden>Delete item…</button>
        <div id="delete-confirmation" hidden>
          <p>Delete this item? Deletion is permanent. There is no trash or undo.</p>
          <button id="confirm-delete" type="button">Permanently delete</button>
          <button id="cancel-delete" type="button">Keep item</button>
        </div>
      </form>
      <p id="save-status" role="status"></p>
      <div id="collection-tools" hidden>
        <h2>Named collections</h2>
        <p>Collection names are public. Deleting a collection keeps its items.</p>
        <form id="create-collection">
          <label>New collection name <input name="name" required maxlength="100" /></label>
          <button>Create collection</button>
        </form>
        <p id="collection-status" role="status"></p>
        <ul id="collection-list"></ul>
      </div>
      <div id="draft-tools" hidden>
        <h2>Drafts — owner only</h2>
        <p id="draft-status" role="status"></p>
        <button id="retry-drafts" type="button">Reload drafts</button>
        <ul id="drafts-board" aria-label="Draft likes"></ul>
      </div>
    </details>
    <noscript>Enable JavaScript to load the public Likes board.</noscript>
    <nav id="collection-filters" aria-label="Named collections"></nav>
    <p id="read-status" role="status">Loading Likes…</p>
    <button id="retry-read" type="button">Retry</button>
    <ul id="likes-board" aria-label="Published likes"></ul>
    <dialog id="image-viewer" aria-label="Image viewer">
      <button type="button" autofocus>Close image</button>
      <p role="status"></p>
      <img alt="" />
    </dialog>
  </section>
</Layout>

<script>
  import '../scripts/likes.js';
</script>

<style is:global>
  main.likes-layout { justify-content: flex-start; text-align: left; max-width: 90rem; }
  #likes { width: 100%; }
  #likes h1 { margin-bottom: 1rem; }
  #likes .owner-tools { margin-bottom: 1.5rem; }
  #likes summary, #likes button { cursor: pointer; }
  #likes form { max-width: 38rem; margin-block: 1rem; }
  #likes label { display: block; margin-block: .75rem; }
  #likes input, #likes textarea { display: block; width: 100%; }
  #likes input[type="checkbox"] { display: inline-block; width: auto; }
  #drafts-board { list-style: none; padding: 0; }
  #drafts-board li { margin-block: 1rem; }
  #drafts-board .like-preview { display: none; }
  #drafts-board p { white-space: pre-wrap; overflow-wrap: anywhere; }
  #likes input, #likes textarea, #likes button {
    font: inherit; color: var(--nord6); background: var(--nord1);
    border: 1px solid var(--nord3); border-radius: .25rem; padding: .5rem .75rem;
  }
  #likes :focus-visible { outline: 2px solid var(--nord8); outline-offset: 3px; }
  #likes [hidden] { display: none; }
  #likes button:disabled { opacity: .6; cursor: wait; }
  #collection-filters { display: flex; flex-wrap: wrap; gap: .75rem; margin-block: 1rem; }
  #collection-filters [aria-current="page"] { font-weight: bold; text-decoration: underline; }
  #likes-board { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: 2rem 1.5rem; }
  #likes-board li { min-width: 0; }
  #likes-board a { display: block; color: inherit; text-decoration: none; }
  #likes-board .image-card { display: block; width: 100%; padding: 0; text-align: left; background: none; border: 0; }
  #image-viewer { max-width: 95vw; max-height: 95vh; color: var(--nord6); background: var(--nord0); border: 1px solid var(--nord3); }
  #image-viewer::backdrop { background: rgb(0 0 0 / .8); }
  #image-viewer img { display: block; max-width: 85vw; max-height: 75vh; object-fit: contain; margin: auto; }
  #likes-board a:hover h2 { text-decoration: underline; }
  #likes-board h2 { font-size: 1rem; font-weight: 400; margin: .75rem 0 .25rem; overflow-wrap: anywhere; }
  #likes-board p { color: var(--nord4); white-space: pre-wrap; overflow-wrap: anywhere; }
  .like-preview { aspect-ratio: 1; background: var(--nord1); display: flex; align-items: center; justify-content: center; padding: 1rem; overflow-wrap: anywhere; overflow: hidden; color: var(--nord4); }
  .like-preview img { width: 100%; height: 100%; object-fit: contain; }
</style>
