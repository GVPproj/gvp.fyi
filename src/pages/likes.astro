---
import Layout from '../layouts/Layout.astro';
import PublishedItems from '../components/likes/PublishedItems.astro';
import { createLikesAPI } from '../lib/likes.js';

export const prerender = false;

// Netlify Functions need this variable at runtime as well as at build time.
const endpoint = process.env.PUBLIC_POCKETBASE_URL ?? import.meta.env.PUBLIC_POCKETBASE_URL ?? '';
const selectedCollection = Astro.url.searchParams.get('collection') ?? '';
const afterCreated = Astro.url.searchParams.get('afterCreated');
const afterId = Astro.url.searchParams.get('afterId');
const cursor = afterCreated && afterId ? { created: afterCreated, id: afterId } : null;
let items = [], collections = [], nextCursor = null, error = '';

// Start uncached: publication changes should be reflected on the next request.
Astro.response.headers.set('Cache-Control', 'no-store');
const api = createLikesAPI(endpoint, (url, options) => fetch(url, {
  ...options, signal: AbortSignal.timeout(8000),
}));
try {
  const [page, groups] = await Promise.all([
    api.listPage({ collection: selectedCollection, cursor }),
    api.listCollections(),
  ]);
  items = page.items;
  nextCursor = page.nextCursor;
  collections = groups;
} catch {
  Astro.response.status = 503;
  error = 'Likes is temporarily unavailable.';
}
---

<Layout title="Likes" wide clientRouter={false}>
  <section id="likes">
    <h1>Likes</h1>
    <PublishedItems {items} {collections} {selectedCollection} {nextCursor} {error} {endpoint} />
    <p id="manage-likes" class="manage" hidden><a href="/likes/manage">Manage Likes</a></p>
  </section>
</Layout>

<script>
  import '../scripts/manage-likes-link.js';
</script>

<style>
  :global(main.likes-layout) { justify-content: flex-start; text-align: left; max-width: 90rem; }
  #likes { width: 100%; }
  h1 { margin-bottom: 1rem; }
  .manage { margin-top: 2rem; }
</style>
