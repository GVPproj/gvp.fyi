---
import type { InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getRadioEpisodes } from '../../lib/radio-episodes';
import { categorySettings } from '../../lib/site-settings';

export async function getStaticPaths() {
  return (await getRadioEpisodes()).map(episode => ({
    params: { slug: episode.slug }, props: { episode },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { episode } = Astro.props;
const programme = categorySettings('radio').find(category => category.id === episode.category)!;
---

<Layout title={episode.title} type="article" alignWithHeader>
  <article class="episode-detail">
    <a href="/radio/">← Radio</a>
    <header>
      <p>{programme.title}</p>
      <h1>{episode.title}</h1>
    </header>
    <Image src={episode.image} alt={`${programme.title} — ${episode.title} artwork`}
      layout="constrained" sizes="calc(100vw - 3rem)"
      loading="eager" decoding="async" />
    <a href={episode.mixcloud}>Listen on Mixcloud</a>
  </article>
</Layout>

<style>
  .episode-detail { width: 100%; display: grid; gap: 1.5rem; text-align: left; overflow-wrap: anywhere; }
  :global(main:has(.episode-detail)) { justify-content: flex-start; }
  header { display: grid; gap: .5rem; }
  header p { color: var(--nord4); }
  img { display: block; width: 100%; height: auto; background: var(--nord1); }
  a { color: var(--color-accent); }
  a:hover { color: var(--nord7); }
  a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
</style>
