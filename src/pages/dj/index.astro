---
import Layout from '../../layouts/Layout.astro';
import ContentRow from '../../components/ContentRow.astro';
import { getDjEpisodes } from '../../lib/dj-episodes';
import { getCollectionOverview } from '../../lib/categorized-content';
import { sectionLabel } from '../../lib/site-settings';

const rows = getCollectionOverview('dj', await getDjEpisodes());
---

<Layout title={sectionLabel('dj')}>
  <div class="dj-episodes">
    <h1>{sectionLabel('dj')}</h1>
    {rows.map(row => <ContentRow
      id={`programme-${row.id}`}
      title={row.title}
      summary={`${row.items.length} ${row.items.length === 1 ? 'recording' : 'recordings'}`}
      items={row.items.map(({ href, title, image }) => ({ href, title, image }))}
    />)}
  </div>
</Layout>

<style>
  .dj-episodes { width: 100%; max-width: 87rem; text-align: left; display: grid; gap: 1.5rem; }
  :global(main:has(.dj-episodes)) { justify-content: flex-start; }
</style>
