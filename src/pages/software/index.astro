---
import Layout from '../../layouts/Layout.astro';
import ContentRow from '../../components/ContentRow.astro';
import { getCollectionOverview } from '../../lib/categorized-content';
import { getSoftwareProjects } from '../../lib/software-projects';
import { sectionLabel } from '../../lib/site-settings';

const rows = getCollectionOverview('software', await getSoftwareProjects());
const title = sectionLabel('software');
---

<Layout title={title}>
  <div class="software">
    <h1>{title}</h1>
    {rows.map(row => <ContentRow
      id={row.id}
      title={row.title}
      summary={`${row.items.length} ${row.items.length === 1 ? 'project' : 'projects'}`}
      items={row.items}
    />)}
  </div>
</Layout>

<style>
  .software { width: 100%; max-width: 87rem; text-align: left; display: grid; gap: 1.5rem; }
  :global(main:has(.software)) { justify-content: flex-start; }
</style>
