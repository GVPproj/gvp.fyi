---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import ContentBody from '../../components/ContentBody.astro';
import Layout from '../../layouts/Layout.astro';
import { getSoftwareProjects } from '../../lib/software-projects';
import { Image } from 'astro:assets';
import { sectionLabel } from '../../lib/site-settings';

export async function getStaticPaths() {
  return (await getSoftwareProjects()).map(project => ({
    params: { slug: project.entry.id },
    props: { project },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props;
const { Content } = await render(project.entry);
---

<Layout title={project.title} alignWithHeader>
  <article class="software-detail">
    <a href="/software">← {sectionLabel('software')}</a>
    <header>
      <h1>{project.title}</h1>
    </header>
    {project.showScreenshot && <Image class="screenshot" src={project.image} layout="constrained" sizes="calc(100vw - 3rem)" alt={project.screenshotAlt ?? `Screenshot of ${project.title}`} />}
    <ContentBody><Content /></ContentBody>
    <section aria-labelledby="tooling-heading">
      <h2 id="tooling-heading">Originally Built With</h2>
      <ul class="tooling">{project.tooling.map(tool => <li>{tool}</li>)}</ul>
    </section>
    {(project.url || project.repo) && <nav aria-label="Project links">
      {project.url && <a href={project.url}>Visit website</a>}
      {project.repo && <a href={project.repo}>GitHub repository</a>}
    </nav>}
    {project.gallery && <section aria-label="Project screenshots" class="gallery">
      {project.gallery.map(image => <Image
        src={image.src}
        layout="constrained"
        sizes="calc(100vw - 3rem)"
        alt={image.alt}
      />)}
    </section>}
    {project.team && <section aria-labelledby="team-heading">
      <h2 id="team-heading">Team</h2>
      <ul class="team">
        {project.team.map(member => <li>
          {member.href ? <a href={member.href}>{member.name}</a> : <span>{member.name}</span>}
          {' — '}{member.role}
        </li>)}
      </ul>
    </section>}
  </article>
</Layout>

<style>
  .software-detail { width: 100%; display: grid; gap: 1.5rem; text-align: left; color: var(--color-foreground); overflow-wrap: anywhere; }
  :global(main:has(.software-detail)) { justify-content: flex-start; }
  header, .gallery { display: grid; gap: 1rem; }
  h2 { margin: 0 0 .75rem; font-size: 1.25rem; font-weight: 400; }
  img { display: block; width: 100%; height: auto; background: var(--nord1); }
  .tooling { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; list-style: none; margin: 0; padding: 0; color: var(--nord4); }
  nav { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; }
  .team { display: grid; gap: .75rem; padding-inline-start: 1.25rem; margin: 0; }
  a { color: var(--color-accent); }
  a:hover { color: var(--nord7); }
  a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
</style>
