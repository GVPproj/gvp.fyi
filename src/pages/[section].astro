---
import Layout from '../layouts/Layout.astro';
import { siteSettings } from '../lib/site-settings';

export function getStaticPaths() {
  return siteSettings.placeholders.map(({ slug, title, body }) => ({
    params: { section: slug },
    props: { title, body },
  }));
}

const { title, body } = Astro.props;
---

<Layout title={title}>
  <h1>{title}</h1>
  <p>{body}</p>
</Layout>
