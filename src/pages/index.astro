---
// import Face from '../components/elements/Face.astro';
import underConstruction from '../../under-construction.gif?url';
import AmbientPad from '../components/AmbientPad.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="home-playground">
    <img src={underConstruction} alt="Under construction" />
    <AmbientPad />
    {/* <Face /> */}
  </div>
</Layout>

<style>
  .home-playground {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 6vw, 6rem);
    width: 100%;
  }

  .home-playground > img {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 400px) {
    /* Keep room for the controller inset and 44px pads on narrow screens. */
    .home-playground { width: calc(100% + clamp(0px, calc(7.5rem - 30vw), 1.5rem)); }
  }
</style>
