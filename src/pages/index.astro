---
import Face from '../components/Face.astro';
import AmbientPad from '../components/AmbientPad.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="home-playground">
    <AmbientPad />
    <Face />
  </div>
</Layout>

<style>
  .home-playground {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 6vw, 6rem);
    width: 100%;
  }

  @media (max-width: 760px) {
    .home-playground { flex-direction: column; }
  }
</style>
