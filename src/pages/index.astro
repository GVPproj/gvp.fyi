---
import AmbientPad from '../components/AmbientPad.astro';
import Testimonials from '../components/Testimonials.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="home-playground">
    <h1 class="home-intro">
      Maker of <a href="/music">music</a> and <a href="/software">software</a>.
    </h1>
    <AmbientPad />
    <Testimonials />
  </div>
</Layout>

<style>
  .home-playground {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10rem;
    width: 100%;
  }

  .home-intro {
    /* max-width: 24ch; */
    width: min(100%, 29rem);
    padding-block-start: clamp(3rem, 5vw, 5rem);
    font-size: clamp(3rem, 4vw, 4rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .home-intro a {
    color: inherit;
    text-decoration-color: var(--nord3);
    text-underline-offset: 0.12em;
    text-decoration-thickness: 0.04em;
  }

  .home-intro a:hover,
  .home-intro a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  @media (max-width: 400px) {
    .home-playground { width: calc(100% + clamp(0px, calc(7.5rem - 30vw), 1.5rem)); }
  }
</style>
