---
// import Face from '../components/Face.astro';
import AmbientPad from '../components/AmbientPad.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="home-playground">
    <AmbientPad />
    {/* <Face /> */}
  </div>
</Layout>

<style>
  .home-playground {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 6vw, 6rem);
    width: 100%;
  }

  @media (max-width: 760px) {
    .home-playground { flex-direction: column; }
  }

  @media (max-width: 400px) {
    /* Keep room for the controller inset and 44px pads on narrow screens. */
    .home-playground { width: calc(100% + clamp(0px, calc(7.5rem - 30vw), 1.5rem)); }
  }
</style>
