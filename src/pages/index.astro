---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getMusicReleases } from '../lib/music-releases';
import AmbientPad from '../components/AmbientPad.astro';
import PixelBox from '../components/elements/PixelBox.astro';
import Testimonials from '../components/Testimonials.astro';
import Layout from '../layouts/Layout.astro';

const latestAlbum = (await getMusicReleases())[0];
const latestPost = (await getCollection('blog'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))[0];
const firstParagraph = latestPost?.body?.trim().split(/\n\s*\n/)[0].replace(/\s+/g, ' ') ?? '';
const excerpt = firstParagraph.length > 160
  ? `${firstParagraph.slice(0, 160).replace(/\s+\S*$/, '')}…`
  : firstParagraph;
---

<Layout alignWithHeader>
  <div class="home-playground">
    <h1 class="home-intro">
      I enjoy making <a href="/music">music</a> and <a href="/software">programming</a> the computer.

    </h1>
    <AmbientPad />
    {latestAlbum && (
      <section class="latest-album" aria-labelledby="latest-album-heading">
        <h2 id="latest-album-heading">Latest Album:</h2>
        <PixelBox>
          <a class="latest-album-cover" href={latestAlbum.href} aria-label={`View ${latestAlbum.title} by ${latestAlbum.artist}`}>
            <Image src={latestAlbum.image} alt={`${latestAlbum.title} album cover`} widths={[320, 640, 960]} sizes="(min-width: 48rem) 416px, calc(100vw - 6rem)" />
          </a>
        </PixelBox>
      </section>
    )}
    {latestPost && (
      <section class="latest-post" aria-labelledby="latest-post-heading">
        <h2 id="latest-post-heading">Latest blog post:</h2>
        <PixelBox>
          <a class="latest-post-card" href={`/blog/${latestPost.id}/`} aria-labelledby="latest-post-title">
            <time datetime={latestPost.data.date}>{latestPost.data.date}</time>
            <h3 id="latest-post-title">{latestPost.data.title}</h3>
            {excerpt && <p>{excerpt}</p>}
          </a>
        </PixelBox>
      </section>
    )}
    <Testimonials />
  </div>
</Layout>

<style>
  .home-playground {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6rem;
    width: min(100%, 29rem);
  }

  .home-intro {
    width: 100%;
    padding-block-start: clamp(2rem, 4vw, 3rem);
    font-size: clamp(1.75rem, 2.5vw, 3.5rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .home-intro a {
    color: inherit;
    text-decoration-color: var(--nord3);
    text-underline-offset: 0.12em;
    text-decoration-thickness: 0.04em;
  }

  .home-intro a:hover,
  .home-intro a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  .latest-album,
  .latest-post {
    width: 100%;
    text-align: left;
  }

  .latest-album h2,
  .latest-post h2 {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
  }

  .latest-album {
    max-width: 29rem;
  }

  .latest-album-cover {
    display: block;
    box-sizing: border-box;
    min-width: 0;
    padding: 1.5rem;
    border: 4px solid transparent;
    box-shadow: inset 2px 2px 0 var(--nord3), inset -2px -2px 0 var(--nord0);
  }

  .latest-album-cover img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    box-sizing: border-box;
    border: 3px solid var(--nord0);
    box-shadow: 2px 2px 0 var(--nord3), -2px -2px 0 #171c25;
  }

  .latest-album-cover:hover { background: var(--nord2); }
  .latest-album-cover:focus-visible { outline: 2px solid var(--nord8); outline-offset: -4px; }

  .latest-post h3 {
    margin: 0;
    font-size: 1.5rem;
    overflow-wrap: anywhere;
  }

  .latest-post-card {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .latest-post-card h3 { text-decoration: underline; text-underline-offset: 0.18em; }
  .latest-post-card:hover { background: var(--nord2); color: var(--nord8); }
  .latest-post-card:focus-visible { outline: 2px solid var(--nord8); outline-offset: -4px; }
  .latest-post time { color: var(--nord4); font-size: 0.875rem; }
  .latest-post p { margin: 0; color: var(--nord4); line-height: 1.5; }

  @media (width >= 48rem) {
    .home-playground { width: 100%; }
  }

  @media (max-width: 400px) {
    .home-playground { width: calc(100% + clamp(0px, calc(7.5rem - 30vw), 1.5rem)); }
  }
</style>
