---
import AmbientPad from '../components/AmbientPad.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="home-playground">
    <h1 class="home-intro">
      Graham Van Pelt makes <a href="/music">music</a> and <a href="/software">software</a>
    </h1>
    <AmbientPad />
  </div>
</Layout>

<style>
  .home-playground {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 6vw, 6rem);
    width: 100%;
  }

  .home-intro {
    max-width: 24ch;
    padding-block-start: clamp(1rem, 4vw, 3rem);
    font-size: clamp(1.75rem, 4.5vw, 3rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .home-intro a {
    color: inherit;
    text-decoration-color: var(--nord3);
    text-underline-offset: 0.12em;
    text-decoration-thickness: 0.04em;
  }

  .home-intro a:hover,
  .home-intro a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  @media (max-width: 400px) {
    /* Keep room for the controller inset and 44px pads on narrow screens. */
    .home-playground { width: calc(100% + clamp(0px, calc(7.5rem - 30vw), 1.5rem)); }
  }
</style>
