---
import { getCollection } from 'astro:content';
import { getMusicReleases } from '../lib/music-releases';
import { getLikes } from '../lib/likes-collection';
import { getRadioEpisodes } from '../lib/radio-episodes';
import CdPlayer from '../components/cd-player/CdPlayer.astro';
import ContentRow from '../components/ContentRow.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import PixelBox from '../components/elements/PixelBox.astro';
import Testimonials from '../components/Testimonials.astro';
import Layout from '../layouts/Layout.astro';

const latestItemLimit = 4;
const latestAlbums = (await getMusicReleases()).slice(0, latestItemLimit);
const latestLikes = (await getLikes()).slice(0, latestItemLimit);
const latestMixes = (await getRadioEpisodes()).slice(0, latestItemLimit);
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date) || a.id.localeCompare(b.id));
const latestPost = posts[0];
const latestJournal = posts.find(post => post.data.audioJournal)?.data.audioJournal;
const audioJournal = latestPost?.data.audioJournal;
---

<Layout alignWithHeader>
  <div class="home-playground">
    <h1 class="home-intro">
Making <span class="intro-word"><a href="/music">music</a>,</span> <span class="intro-word"><a href="/radio">radio</a>,</span> and <span class="intro-word"><a href="/software">software</a>.</span>

    </h1>
    {latestJournal && <CdPlayer title={latestJournal.title} src={latestJournal.src} />}
    {latestPost && (
      <section class="latest-post" aria-labelledby="latest-post-heading">
        <h2 id="latest-post-heading">Latest blog post:</h2>
        <PixelBox>
          <a class="latest-post-card" href={`/blog/${latestPost.id}/`} aria-labelledby="latest-post-title">
            <time datetime={latestPost.data.date}>{latestPost.data.date}</time>
            <h3 id="latest-post-title">{latestPost.data.title}</h3>
            {!audioJournal && <p>{latestPost.data.summary}</p>}
          </a>
          {audioJournal && (
            <div class="latest-post-player">
              <MusicPlayer title={latestPost.data.title} showHeader={false} tracks={[audioJournal]} />
            </div>
          )}
        </PixelBox>
      </section>
    )}
    {latestAlbums.length > 0 && <ContentRow id="latest-album" title="Latest Albums:" items={latestAlbums} layout="grid" />}
    {latestMixes.length > 0 && <ContentRow id="latest-mix" title="Latest Radio Shows:" items={latestMixes} layout="grid" />}
    {latestLikes.length > 0 && <ContentRow id="latest-like" title="Latest Likes:" items={latestLikes} layout="grid" />}
    <Testimonials />
  </div>
</Layout>

<style>
  .home-playground {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6rem;
    width: min(100%, 29rem);
  }

  .home-intro {
    width: 100%;
    padding-block-start: clamp(2rem, 4vw, 3rem);
    font-size: clamp(1.75rem, 2.5vw, 3.5rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .intro-word {
    white-space: nowrap;
  }

  .home-intro a {
    color: inherit;
    text-decoration-color: var(--nord3);
    text-underline-offset: 0.12em;
    text-decoration-thickness: 0.04em;
  }

  .home-intro a:hover,
  .home-intro a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  .latest-post {
    width: 100%;
    text-align: left;
  }

  .latest-post h2,
  .home-playground :global(.content-row-grid h2) {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
    color: var(--color-accent);
  }

  .latest-post h3 {
    margin: 0;
    font-size: 1.5rem;
    overflow-wrap: anywhere;
  }

  .latest-post-card {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .latest-post-card h3 { text-decoration: underline; text-underline-offset: 0.18em; }
  .latest-post-card:hover { background: var(--nord2); color: var(--nord8); }
  .latest-post-card:focus-visible { outline: 2px solid var(--nord8); outline-offset: -4px; }
  .latest-post-player { padding: 0 0.75rem 1.5rem; }
  .latest-post time { color: var(--nord4); font-size: 0.875rem; }
  .latest-post p { margin: 0; color: var(--nord4); line-height: 1.5; }

  @media (width >= 48rem) {
    .home-playground { width: 100%; }
  }

  @media (max-width: 400px) {
    .home-playground { width: calc(100% + clamp(0px, calc(7.5rem - 30vw), 1.5rem)); }
  }
</style>
