---
import Layout from '../../layouts/Layout.astro';
import { likeItemTitle, likeAssetKind, webURL } from '../../lib/likes.js';
import { publishedLikes } from '../../lib/published-likes.js';
export function getStaticPaths() {
  return publishedLikes.map(item => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const title = likeItemTitle(item);
const source = webURL(item.url);
const asset = item.publishedAsset?.url;
const pdf = asset && likeAssetKind(item) === 'pdf';
const textItem = item?.type === 'quote' || item?.type === 'note';
---

<Layout {title}>
  <article id="like-detail" class="like-detail">
    <a href="/likes">← Likes</a>
    <header><h1>{title}</h1></header>
    <>
        {textItem && (item.type === 'quote' ? (
          <figure class="quotation">
            <blockquote>{item.body ?? ''}</blockquote>
            {item.attribution && <figcaption>{item.attribution}</figcaption>}
          </figure>
        ) : (
          <>
            <p class="full-text">{item.body ?? ''}</p>
            {item.attribution && <p class="attribution">{item.attribution}</p>}
          </>
        ))}
        {asset && !pdf && <img src={asset} srcset={item.publishedAsset?.srcset || undefined} sizes="(min-width: 45rem) 65ch, calc(100vw - 3rem)" alt={title} width={item.publishedAsset?.width} height={item.publishedAsset?.height} loading="lazy" />}
        {asset && <p><a href={asset} target="_blank" rel="noopener noreferrer">{pdf ? 'Open PDF' : 'Open original image'}</a></p>}
        {source && <p><a class="source" href={source} target="_blank" rel="noopener noreferrer">Source: {new URL(source).hostname}</a></p>}
        {item.description && <p class="description">{item.description}</p>}
        {item.commentary && <p class="commentary">{item.commentary}</p>}
    </>
  </article>
</Layout>

<style>
  .like-detail { width: min(100%, 65ch); display: grid; gap: 1.5rem; text-align: left; color: var(--color-foreground); overflow-wrap: anywhere; }
  :global(main:has(.like-detail)) { justify-content: flex-start; }
  h1, p, blockquote, figcaption { white-space: pre-wrap; }
  .quotation { display: grid; gap: 1rem; margin: 0; }
  blockquote { margin: 0; padding-inline-start: 1rem; border-inline-start: 2px solid var(--nord4); }
  .attribution, figcaption, .description, .commentary { color: var(--nord4); }
  img { display: block; width: 100%; height: auto; object-fit: contain; background: var(--nord1); }
  a { color: var(--color-accent); }
  a:hover { color: var(--nord7); }
  a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
</style>
