---
import Layout from '../../layouts/Layout.astro';
import ContentRow from '../../components/ContentRow.astro';
import { collectionOverview as rows } from '../../lib/likes-collection';
import { sectionLabel } from '../../lib/site-settings';
---

<Layout title={sectionLabel('likes')}>
  <div class="likes">
    <h1>{sectionLabel('likes')}</h1>
    <div id="collection-rows">
      {rows.map(row => <ContentRow
        id={`collection-${row.id}`}
        title={row.name}
        summary={`${row.items.length} ${row.items.length === 1 ? 'item' : 'items'}`}
        items={row.items}
      />)}
    </div>
  </div>
</Layout>

<style>
  .likes { width: 100%; max-width: 87rem; text-align: left; display: grid; gap: 1.5rem; }
  #collection-rows { display: grid; gap: 1.5rem; min-width: 0; }
  :global(main:has(.likes)) { justify-content: flex-start; }
</style>
