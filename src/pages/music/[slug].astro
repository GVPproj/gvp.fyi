---
import type { InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import ContentBody from '../../components/ContentBody.astro';
import Layout from '../../layouts/Layout.astro';
import { getMusicReleases } from '../../lib/music-releases';

export async function getStaticPaths() {
  return (await getMusicReleases()).map(release => ({
    params: { slug: release.slug },
    props: { release },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { release } = Astro.props;
const { Content } = await render(release.entry);
const streaming = [
  { label: 'Spotify', url: release.streaming?.spotify },
  { label: 'Apple Music', url: release.streaming?.apple },
  { label: 'Tidal', url: release.streaming?.tidal },
].filter(link => link.url);
---

<Layout title={release.title}>
  <article class="release-detail">
    <a href="/music">← Music</a>
    <header>
      <h1>{release.title}</h1>
      <p>{release.artist}</p>
      {release.credit && <p class="release-credit">Graham Van Pelt — {release.credit}</p>}
      <p><time datetime={release.date}>{release.display_date ?? release.date}</time></p>
    </header>
    <div class="release-media">
      <Image src={release.image} alt={`${release.title} album cover`}
        layout="constrained"
        sizes="(max-width: 48rem) calc(100vw - 2rem), 65ch"
        loading="eager" decoding="async" />
      {release.album_id && <iframe
        title={`Bandcamp player — ${release.title} by ${release.artist}`}
        src={`https://bandcamp.com/EmbeddedPlayer/album=${release.album_id}/size=large/bgcol=2e3440/linkcol=88c0d0/artwork=none/transparent=true/`}
        height={release.player_height ?? 406}
        loading="lazy"
      ></iframe>}
    </div>
    {release.url || streaming.length > 0 ? <nav aria-label="Listen to this release">
      {release.url && <a href={release.url}>Bandcamp</a>}
      {streaming.map(link => <a href={link.url}>{link.label}</a>)}
    </nav> : !release.entry.body?.trim() && <p>No listening link is currently available for this release.</p>}
    {release.entry.body?.trim() && <ContentBody><Content /></ContentBody>}
  </article>
</Layout>

<style>
  .release-detail { width: min(100%, 65ch); display: grid; gap: 1.5rem; text-align: left; overflow-wrap: anywhere; }
  :global(main:has(.release-detail)) { justify-content: flex-start; }
  header { display: grid; gap: .5rem; }
  header p { color: var(--nord4); }
  .release-media { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  img { display: block; width: 100%; height: auto; background: var(--nord1); }
  iframe { width: 100%; border: 0; }
  nav { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; }
  a { color: var(--color-accent); }
  a:hover { color: var(--nord7); }
  a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
</style>
