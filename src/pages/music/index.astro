---
import Layout from '../../layouts/Layout.astro';
import ContentRow from '../../components/ContentRow.astro';
import { releaseCategories } from '../../lib/music-releases';
import { sectionLabel } from '../../lib/editorial-content';
---

<Layout title={sectionLabel('music')}>
  <div class="music-releases">
    <h1>{sectionLabel('music')}</h1>
    {releaseCategories.map(category => <ContentRow
      id={`category-${category.id}`}
      title={category.name}
      summary={`${category.releases.length} ${category.releases.length === 1 ? 'release' : 'releases'}`}
      items={category.releases.map(release => ({
        href: `/music/${release.slug}`,
        title: release.title,
        image: { src: release.publishedArtwork.thumbnail, srcset: release.publishedArtwork.srcset,
          width: release.publishedArtwork.width, height: release.publishedArtwork.height },
        subtitle: release.credit ? release.artist : undefined,
        metadata: release.credit,
      }))}
    />)}
  </div>
</Layout>

<style>
  .music-releases { width: 100%; max-width: 87rem; text-align: left; display: grid; gap: 1.5rem; }
  :global(main:has(.music-releases)) { justify-content: flex-start; }
</style>
