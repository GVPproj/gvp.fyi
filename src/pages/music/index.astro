---
import Layout from '../../layouts/Layout.astro';
import ContentRow from '../../components/ContentRow.astro';
import { getMusicReleases } from '../../lib/music-releases';
import { getCollectionOverview } from '../../lib/categorized-content';
import { sectionLabel } from '../../lib/site-settings';

const rows = getCollectionOverview('music', await getMusicReleases());
---

<Layout title={sectionLabel('music')}>
  <div class="music-releases">
    <h1>{sectionLabel('music')}</h1>
    {rows.map(row => <ContentRow
      id={`category-${row.id}`}
      title={row.title}
      summary={`${row.items.length} ${row.items.length === 1 ? 'release' : 'releases'}`}
      items={row.items}
    />)}
  </div>
</Layout>

<style>
  .music-releases { width: 100%; max-width: 87rem; text-align: left; display: grid; gap: 1.5rem; }
  :global(main:has(.music-releases)) { justify-content: flex-start; }
</style>
