---
import { blogPosts, sectionLabel } from '../../lib/editorial-content';
import Layout from '../../layouts/Layout.astro';

const posts = await blogPosts();
const title = sectionLabel('blog');
---

<Layout title={title}>
  <h1>{title}</h1>
  <ul>
    {posts.map((post) => (
      <li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
    ))}
  </ul>
</Layout>

<style>
  ul { list-style: none; margin: 0; padding: 0; }
  li + li { margin-block-start: 1rem; }
  a { color: var(--color-accent); }
</style>
