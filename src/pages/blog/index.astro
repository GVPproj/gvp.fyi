---
import { getDatedEntries } from '../../lib/dated-entries';
import { sectionLabel } from '../../lib/site-settings';
import Layout from '../../layouts/Layout.astro';

const posts = await getDatedEntries('blog');
const journals = await getDatedEntries('musicJournal');
const title = sectionLabel('blog');
---

<Layout title={title} collection>
  <h1 class="sr-only">{title}</h1>
  {[{ heading: null, entries: posts }, { heading: 'Music Journal', entries: journals }].map(({ heading, entries }) =>
    entries.length > 0 && <>
      {heading && <h2>{heading}</h2>}
      <ul>
        {entries.map(({ id, data }) => (
          <li><a href={`/blog/${id}/`}>{data.title}</a> - <time datetime={data.date}>{data.date}</time></li>
        ))}
      </ul>
    </>
  )}
</Layout>

<style>
  h2 { color: var(--color-foreground); }
  ul { list-style: none; margin: 0; padding: 0; }
  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.5ch;
  }
  li + li { margin-block-start: 1rem; }
  a { display: flex; color: var(--color-accent); }
</style>
