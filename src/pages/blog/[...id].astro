---
import { render } from 'astro:content';
import { blogPosts, fullEditorialMode, sectionLabel } from '../../lib/editorial-content';
import { renderBlogMarkdown } from '../../lib/blog-markdown.js';
import Face from '../../components/Face.astro';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await blogPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: Awaited<ReturnType<typeof blogPosts>>[number];
}

const { post } = Astro.props;
const Content = !fullEditorialMode ? (await render(post as import('astro:content').CollectionEntry<'blog'>)).Content : null;
const parts = 'assets' in post ? renderBlogMarkdown(post.data.markdown, { assets: post.assets, assetNames: post.data.assetNames }) : [];
---

<Layout title={post.data.title}>
  <article>
    <header>
      <a href="/blog/">← {sectionLabel('blog')}</a>
      <h1>{post.data.title}</h1>
    </header>
    <div class="post-body">{Content ? <Content /> : parts.map(part => part.demo === 'face' ? <Face /> : <Fragment set:html={part.html} />)}</div>
  </article>
</Layout>

<style>
  article {
    width: min(100%, 65ch);
    text-align: left;
    overflow-wrap: anywhere;
  }

  a { color: var(--color-accent); }
  h1 { margin-block: 1rem 2rem; }
  .post-body { color: var(--color-foreground); }
  .post-body :global(> * + *) { margin-block-start: 1.5rem; }
  .post-body :global(.face) { margin-inline: auto; }
  .post-body :global(code) { font-size: 0.95em; color: var(--color-accent); }
  .post-body :global(pre) {
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--nord2);
    border-radius: 0.375rem;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.875rem;
    line-height: 1.5rem;
  }
  .post-body :global(pre code) { font-size: inherit; color: inherit; }
  .post-body :global(a) { color: var(--color-accent); }
</style>
