---
import { getCollection, type CollectionEntry } from 'astro:content';
import BlogPostBody from '../../components/BlogPostBody.astro';
import { sectionLabel } from '../../lib/site-settings';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = [...await getCollection('blog'), ...await getCollection('musicJournal')];
  if (new Set(posts.map(post => post.id)).size !== posts.length) {
    throw new Error('Blog posts and Music Journal entries must have unique /blog/ paths');
  }
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog' | 'musicJournal'>;
}

const { post } = Astro.props;
---

<Layout title={post.data.title} type="article" alignWithHeader>
  <article>
    <header>
      <a href="/blog/">← {sectionLabel('blog')}</a>
      <h1>{post.data.title}</h1>
    </header>
    <div class="post-body"><BlogPostBody {post} /></div>
  </article>
</Layout>

<style>
  article {
    width: 100%;
    text-align: left;
    overflow-wrap: anywhere;
  }

  a { color: var(--color-accent); }
  h1 { margin-block: 1rem 2rem; }
  .post-body { color: var(--color-foreground); }
  .post-body :global(> * + *) { margin-block-start: 1.5rem; }
  .post-body :global(figure) { margin-inline: 0; }
  .post-body :global(img) { max-width: 100%; height: auto; }
  .post-body :global(code) { font-size: 0.95em; color: var(--color-accent); }
  .post-body :global(pre) {
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--nord2);
    border-radius: 0.375rem;
    overflow-x: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.875rem;
    line-height: 1.5rem;
  }
  .post-body :global(pre code) { font-size: inherit; color: inherit; }
  .post-body :global(a) { color: var(--color-accent); }
</style>
