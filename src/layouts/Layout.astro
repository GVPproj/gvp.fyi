---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteSettings } from '../lib/site-settings';
import '../styles/global.css';
import '../styles/cursors.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  alignWithHeader?: boolean;
  collection?: boolean;
}

const { title, description = siteSettings.description, type = 'website', alignWithHeader = false, collection = false } = Astro.props;
const pageTitle = title ? `${title}${siteSettings.title ? ` · ${siteSettings.title}` : ''}` : siteSettings.title;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL('/social/og-image.png', Astro.site);
const imageAlt = 'A fully drawn one-line portrait of Graham Van Pelt beside gvp.fyi.';
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="initial">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const key = 'site-theme';
        const system = matchMedia('(prefers-color-scheme: dark)');
        let preference;
        try { preference = localStorage.getItem(key); } catch { /* Storage may be blocked. */ }
        if (preference !== 'light' && preference !== 'dark') preference = null;
        const theme = () => preference ?? (system.matches ? 'dark' : 'light');
        const apply = (root = document.documentElement) => { root.dataset.theme = theme(); };

        // Set before the first paint and carry it into Astro's incoming page.
        apply();
        system.addEventListener('change', () => apply());
        document.addEventListener('astro:before-swap', event => apply(event.newDocument.documentElement));
        document.addEventListener('click', event => {
          if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
          preference = theme() === 'dark' ? 'light' : 'dark';
          apply();
          try { localStorage.setItem(key, preference); } catch { /* Keep the choice for this visit. */ }
        });
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={siteSettings.title} href={new URL('/rss.xml', Astro.site)} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteSettings.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/fonts/gohu-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div id="navigation-status" role="status" aria-atomic="true"><span></span></div>
    <SiteHeader />
    <main class:list={{ 'header-aligned': alignWithHeader, 'collection-page': collection }} aria-label={title ?? (siteSettings.identity || undefined)}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main.collection-page {
    justify-content: flex-start;
  }

  @media (width >= 48rem) {
    :global(body:has(main.collection-page) .site-header) {
      margin-block-end: 0;
    }

    main.header-aligned {
      grid-column: 2;
      min-width: 0;
      max-width: calc(100% - 3rem);
      padding-inline: 0;
      /* Let the header, not the content's intrinsic width, size this column. */
      contain: inline-size;
    }
  }
</style>

<script>
  import '../scripts/navigation-loading';
  import '../scripts/link-hover';
</script>
