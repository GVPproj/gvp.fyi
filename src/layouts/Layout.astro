---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  wide?: boolean;
  clientRouter?: boolean;
}

const { title, wide = false, clientRouter = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Graham Van Pelt's home on the web." />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/fonts/gohu-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title ? `${title} · gvp.fyi` : 'gvp.fyi'}</title>
    {/* Without router metadata, entering/leaving this page uses native navigation. */}
    {clientRouter && <ClientRouter />}
  </head>
  <body>
    <SiteHeader />
    <main class:list={{ 'likes-layout': wide }} aria-label={title ?? 'Graham Van Pelt'}>
      <slot />
    </main>
  </body>
</html>

<script>
  // Conditional ClientRouter scripts are not emitted in dev when omitted.
  // Keep Astro's initial astro:page-load event for Likes and shared components;
  // the router still requires page metadata to enable client-side navigation.
  import 'astro:transitions/client';
</script>
