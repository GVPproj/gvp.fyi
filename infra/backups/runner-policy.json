{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LocateBackupBucket",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::gvp-pocketbase-backups-524178179132-us-west-2"
    },
    {
      "Sid": "ListRecoveryPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::gvp-pocketbase-backups-524178179132-us-west-2",
      "Condition": {
        "StringLike": { "s3:prefix": ["monthly/*", "candidates/*", "artifacts/*", "rollback/*"] }
      }
    },
    {
      "Sid": "StoreAndVerifyRecoveryObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": [
        "arn:aws:s3:::gvp-pocketbase-backups-524178179132-us-west-2/monthly/*",
        "arn:aws:s3:::gvp-pocketbase-backups-524178179132-us-west-2/candidates/*",
        "arn:aws:s3:::gvp-pocketbase-backups-524178179132-us-west-2/artifacts/*",
        "arn:aws:s3:::gvp-pocketbase-backups-524178179132-us-west-2/rollback/*"
      ]
    },
    {
      "Sid": "PruneMonthlyAndCandidateObjectsOnly",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::gvp-pocketbase-backups-524178179132-us-west-2/monthly/*",
        "arn:aws:s3:::gvp-pocketbase-backups-524178179132-us-west-2/candidates/*"
      ]
    }
  ]
}
