{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAccountAdministration",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::524178179132:root"},
      "Action": ["sns:GetTopicAttributes", "sns:SetTopicAttributes", "sns:Subscribe", "sns:ListSubscriptionsByTopic", "sns:Publish"],
      "Resource": "arn:aws:sns:us-west-2:524178179132:gvp-backup-alerts"
    },
    {
      "Sid": "AllowWatchdogAlarmNotifications",
      "Effect": "Allow",
      "Principal": {"Service": "cloudwatch.amazonaws.com"},
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-west-2:524178179132:gvp-backup-alerts",
      "Condition": {
        "StringEquals": {"aws:SourceAccount": "524178179132"},
        "ArnEquals": {
          "aws:SourceArn": [
            "arn:aws:cloudwatch:us-west-2:524178179132:alarm:gvp-backup-watchdog-errors",
            "arn:aws:cloudwatch:us-west-2:524178179132:alarm:gvp-backup-watchdog-absent"
          ]
        }
      }
    }
  ]
}
