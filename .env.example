# Unset: checked-in music/software/blog content and empty Likes for local development.
# Enable to build published content from PocketBase (no editorial fallback).
# PUBLISHING_CONTENT=true
# PUBLISHING_POCKETBASE_URL=https://pocketbase.example.com
# PUBLISHING_BUILD_EMAIL=
# PUBLISHING_BUILD_PASSWORD=
# Use a restricted publishing_builds identity, NEVER a superuser.
# Set privately in Netlify build context, not PUBLIC_ variables or Git.
