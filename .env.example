# Public API origin only; never put an admin password or token here.
PUBLIC_POCKETBASE_URL=https://pocketbase-fly-starter.fly.dev

# Enable only after backend migration/import and cutover verification.
# Unset preserves the repository/legacy reader for pre-cutover development.
# PUBLISHING_CONTENT=true
# PUBLISHING_POCKETBASE_URL=https://pocketbase-fly-starter.fly.dev
# PUBLISHING_BUILD_EMAIL=
# PUBLISHING_BUILD_PASSWORD=
# Build credentials are a restricted publishing_builds identity, NEVER a superuser.
# Set privately in Netlify build context, not PUBLIC_ variables or Git.
